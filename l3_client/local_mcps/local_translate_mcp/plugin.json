{
  "id": "com.jachin.mcp.local-translate",
  "name": "Local Translate MCP",
  "version": "1.0.14",
  "description": "Local CTranslate2 translation MCP with 10k vocabulary, reviewed example pack, completion cache, and sentence/example cache.",
  "item_type": "MCP",
  "type": "MCP",
  "runtime_tier": "L3_LOCAL",
  "mcp_execution_mode": "stdio_server",
  "required_models": [
    "com.jachin.model.opus-mt-en-zh-ct2-int8",
    "com.jachin.model.opus-mt-zh-en-ct2-int8"
  ],
  "stdio_server": {
    "id": "com.jachin.mcp.local-translate",
    "command": "__JACHIN_MCP_PYTHON__",
    "args": [
      "__MCP_PACKAGE_ROOT__/server.py"
    ],
    "env": {
      "PYTHONIOENCODING": "utf-8"
    }
  },
  "tools": [
    {
      "id": "local_translate_text",
      "function": "local_translate_text",
      "module": "local_translate",
      "description": "Translate Chinese/English text locally with installed OPUS-MT CTranslate2 models.",
      "params": [
        "text",
        "direction"
      ]
    },
    {
      "id": "local_translate_model_status",
      "function": "local_translate_model_status",
      "module": "local_translate",
      "description": "Check whether local translation models are installed and usable.",
      "params": []
    },
    {
      "id": "local_translate_warmup",
      "function": "local_translate_warmup",
      "module": "local_translate",
      "description": "Warm up installed translation models.",
      "params": [
        "direction"
      ]
    },
    {
      "id": "english_example_pack_status",
      "function": "english_example_pack_status",
      "module": "english_example_pack",
      "description": "Check bundled English example pack availability and counts.",
      "params": []
    }
  ],
  "tags": [
    "translation",
    "offline",
    "ctranslate2",
    "opus-mt",
    "model-asset",
    "english-vocab-10k",
    "completion-cache",
    "example-pack"
  ],
  "recovery_playbook": {
    "targets": [
      {
        "id": "local_translate_runtime",
        "role_agent": "ToolExecutionAgent",
        "tools": [
          "*local_translate*",
          "*english_example_pack_status*"
        ],
        "max_attempts": 5,
        "steps": [
          {
            "strategy": "warmup_translation_model",
            "tool": "local_translate_warmup",
            "when": {
              "failure_any": [
                "model_not_ready",
                "model_missing",
                "cold_start",
                "timeout",
                "not initialized",
                "unverified"
              ]
            },
            "action_patch": {
              "direction": "en-zh",
              "recovery_strategy": "warmup_translation_model"
            },
            "rationale": "translation failed because the local model was not warm; warm it before retrying text translation",
            "priority": 10
          },
          {
            "strategy": "check_model_status",
            "tool": "local_translate_model_status",
            "when": {
              "failure_any": [
                "model_missing",
                "model_not_found",
                "runtime_missing",
                "not installed"
              ]
            },
            "action_patch": {
              "include_paths": true,
              "recovery_strategy": "check_model_status"
            },
            "rationale": "surface the exact missing local model/runtime paths instead of repeating a doomed translation call",
            "priority": 20
          },
          {
            "strategy": "retry_same_text_after_warmup",
            "tool": "$same",
            "when": {
              "failure_any": [
                "timeout",
                "busy",
                "connection",
                "temporarily",
                "unverified"
              ],
              "after_attempt": 2
            },
            "action_patch": {
              "timeout": 12.0,
              "recovery_strategy": "retry_same_text_after_warmup"
            },
            "rationale": "after warmup/status check, retry the original translation with a longer local-service window",
            "priority": 55
          }
        ]
      }
    ]
  }
}
