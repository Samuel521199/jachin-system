{
  "productName": "Jachin Desktop Sprite",
  "version": "0.8.111",
  "identifier": "com.jachin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:31421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jachin 控制台",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "url": "console.html"
      },
      {
        "label": "sprite",
        "title": "Jachin Sprite",
        "width": 256,
        "height": 256,
        "minWidth": 256,
        "minHeight": 256,
        "maxWidth": 512,
        "maxHeight": 512,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "sprite.html"
      },
      {
        "label": "chat",
        "title": "Jachin Omni",
        "width": 440,
        "height": 520,
        "minWidth": 360,
        "minHeight": 280,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "chat.html"
      },
      {
        "label": "notification",
        "title": "Jachin 哨兵",
        "width": 380,
        "height": 88,
        "minWidth": 320,
        "minHeight": 72,
        "maxWidth": 480,
        "maxHeight": 160,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "notification.html"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/l3_node"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "http://127.0.0.1:3000/api/v1/update/desktop?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwNjk4MzVEMkREMzA2RjQK\nRWU0BtMtXYNpEDL1uQKXxb8cCNN9x6k7FT+XOmgA+m2zgr+BbmcW4wMm8K",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
