{
  "productName": "Jachin Desktop Sprite",
  "version": "0.9.72",
  "identifier": "com.jachin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:31421",
    "beforeBuildCommand": "npm run build && npm run prepare-installer-payload",
    "beforeBundleCommand": "npm run tauri:before-bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jachin 控制台",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "url": "console.html"
      },
      {
        "label": "sprite",
        "title": "Jachin Sprite",
        "width": 256,
        "height": 256,
        "minWidth": 256,
        "minHeight": 256,
        "maxWidth": 512,
        "maxHeight": 512,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "url": "sprite.html"
      },
      {
        "label": "chat",
        "title": "Jachin Omni",
        "width": 820,
        "height": 640,
        "minWidth": 360,
        "minHeight": 280,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "url": "chat.html",
        "dragDropEnabled": false
      },
      {
        "label": "notification",
        "title": "Jachin 哨兵",
        "width": 380,
        "height": 88,
        "minWidth": 320,
        "minHeight": 72,
        "maxWidth": 480,
        "maxHeight": 160,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "url": "notification.html"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/l3_node"
    ],
    "resources": {
      "../../../dist_jachin_desktop/bin/": "bin/",
      "../../../dist_jachin_desktop/config/": "config/",
      "../../../dist_jachin_desktop/scripts/": "scripts/",
      "../../../dist_jachin_desktop/logs/": "logs/",
      "../../../dist_jachin_desktop/runtime/": "runtime/",
      "../../../dist_jachin_desktop/.env.example": ".env.example",
      "../../../dist_jachin_desktop/.env": ".env",
      "../../../dist_jachin_desktop/.env.sea.example": ".env.sea.example",
      "../../../dist_jachin_desktop/README_DEPLOY.md": "README_DEPLOY.md",
      "../../../dist_jachin_desktop/run_l3.bat": "run_l3.bat",
      "../../../dist_jachin_desktop/run_l3_standalone.bat": "run_l3_standalone.bat",
      "../nexus_config.example.json": "nexus_config.example.json"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer_hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "http://47.86.39.173:3000/api/v1/update/desktop?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "pubkey": "RWT+Ht4hSDqsCEoNM84poJhl0iQDXHPuU3lChuRTZ+ArkkyRGrvnF7ea",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
