{
  "$schema": "../gen/schemas/capabilities.json",
  "identifier": "default",
  "description": "Default capabilities for Jachin Desktop Sprite",
  "windows": ["main", "sprite", "chat", "notification"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "shell:allow-spawn",
    "notification:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "updater:allow-download-and-install",
    "allow-updater-debug-append",
    "allow-spawn-hot-update",
    "allow-app-core-invoke"
  ]
}
