{
  "name": "jachin-desktop",
  "version": "0.8.103",
  "private": true,
  "type": "module",
  "description": "Jachin-System Desktop Console - Tauri v2 + React + TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:l3-sidecar": "python ../../scripts/build_l3_sidecar.py",
    "prebuild": "npm run build:l3-sidecar",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "kill-port-dev": "powershell -ExecutionPolicy Bypass -File ../../scripts/kill_port.ps1 31421",
    "tauri:dev:fresh": "npm run kill-port-dev && npm run tauri:dev",
    "tauri:build": "tauri build",
    "tauri:build:tts": "tauri build --features tts-local",
    "tauri:dev:tts": "tauri dev --features tts-local",
    "tauri:dev:ambient": "tauri dev --features ambient",
    "tauri:build:ambient": "tauri build --features ambient",
    "sync-version": "node scripts/sync-version.mjs",
    "publish-desktop-release": "python ../../scripts/publish_desktop_release.py --sign"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@rive-app/react-canvas": "^4.26.1",
    "@tauri-apps/api": "~2.10.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.0.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.344.0",
    "pixi.js": "^8.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.0",
    "three": "^0.182.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  }
}
