# 复制为 .env 并按需修改（仅 VITE_ 开头的变量会注入前端）
# VITE_ENVIRONMENT=Home Network (Secure)
# VITE_MODEL_NAME=Qwen-72B (Int4)
# VITE_BACKEND_URL=http://localhost:18888
# VITE_DAPR_HTTP_PORT=3502
# VITE_USE_DAPR=true
# 流式聊天：true=直连后端（本地模型推荐，避免 Dapr 缓冲）；false 或不设=跟随 VITE_USE_DAPR
# VITE_CHAT_STREAM_VIA_DIRECT=true
