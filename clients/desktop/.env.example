# 复制为 .env 并按需修改（仅 VITE_ 开头的变量会注入前端）
# V2: Dapr 已废弃，统一直连后端
# VITE_ENVIRONMENT=Home Network (Secure)
# VITE_MODEL_NAME=Qwen-72B (Int4)
# VITE_BACKEND_URL=http://localhost:18888
# L3 技能 API（列表与执行，默认 18991）
# VITE_L3_SKILLS_URL=http://localhost:18991
# VITE_CHAT_STREAM_VIA_DIRECT=true
# L3 WebSocket 端口（默认 18981，与 L2 Sensory 18881 分离）
# VITE_SENSORY_WS_PORT=18981
# Lark 镜像模式：填写 Lark 群聊/私聊 chat_id，终端与 Lark 双向同步（终端为主屏）
# VITE_LARK_CHAT_ID=oc_xxxxxxxx
