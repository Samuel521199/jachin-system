{
  "id": "com.jachin.hr.analyzer3",
  "name": "HR 透析镜 3",
  "version": "1.0.0",
  "description": "根据岗位要求对候选人简历进行严苛评估，输出 Markdown 报告。支持动态配置修改，回收站测试用。",
  "type": "skill",
  "entry": "main.wasm",
  "parameters": ["target_role", "resume_filename"],
  "configs": {
    "JD_template": "云边协同后端架构师：精通 Rust/Go，具备百万级设备接入、高可用分布式系统经验。熟悉 Kubernetes、消息队列、时序数据库。",
    "strict_mode": true,
    "resume_input_dir": "data/hr_resumes",
    "output_dir": "data/hr_analysis",
    "resume_input_dir_use_absolute": false,
    "output_dir_use_absolute": false
  },
  "volumes": [
    { "name": "hr_analysis_output_3", "access_mode": "rw" }
  ]
}
