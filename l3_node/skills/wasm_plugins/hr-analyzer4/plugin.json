{
  "id": "com.jachin.hr.analyzer4",
  "name": "HR 透析镜 4",
  "version": "1.0.0",
  "description": "根据岗位要求对候选人简历进行严苛评估，输出 Markdown 报告。回收站功能测试。",
  "type": "skill",
  "entry": "main.wasm",
  "parameters": ["target_role", "resume_filename", "target_dir"],
  "configs": {
    "JD_template": "（占位：由招聘任务传入的 jd_template 覆盖）请仅按调用方提供的岗位要求评估简历，勿使用任何内置演示岗位描述。",
    "strict_mode": true,
    "resume_input_dir": "data/hr_resumes",
    "output_dir": "data/hr_analysis",
    "resume_input_dir_use_absolute": false,
    "output_dir_use_absolute": false,
    "default_target_role": "backend_engineer",
    "default_resume": "zhangsan_resume.md"
  },
  "volumes": [
    { "name": "hr_analysis_output_4", "access_mode": "rw" }
  ]
}
