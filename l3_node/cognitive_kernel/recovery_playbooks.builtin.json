{
  "capability_id": "builtin.cognitive_kernel.recovery_playbooks",
  "recovery_playbook": {
    "targets": [
      {
        "id": "web_research_delivery_quality",
        "role_agent": "BrowserExecutorAgent",
        "tools": [
          "mcp:tavily_search",
          "mcp:fetch",
          "core:web_research_summarize"
        ],
        "max_attempts": 5,
        "steps": [
          {
            "strategy": "retry_search_with_clean_query",
            "tool": "mcp:tavily_search",
            "when": {
              "failure_any": ["search_results_missing", "search_result_urls_missing", "timeout", "connection"]
            },
            "action_patch": {
              "clean_query": true,
              "max_results": 6,
              "recovery_strategy": "retry_search_with_clean_query"
            },
            "rationale": "search returned no usable source URLs; retry with a cleaned query and more results",
            "priority": 15
          },
          {
            "strategy": "refetch_sources_for_summary",
            "tool": "mcp:fetch",
            "when": {
              "failure_any": ["summary_missing_source_urls", "fetch_readable_content_missing", "fetch_access_or_bot_wall", "missing_search_or_fetch_evidence", "source"]
            },
            "action_patch": {
              "prefer_search_result_urls": true,
              "min_readable_chars": 800,
              "recovery_strategy": "refetch_sources_for_summary"
            },
            "rationale": "summary lacks grounded source evidence; refetch readable pages before regenerating",
            "priority": 25
          },
          {
            "strategy": "regenerate_clean_summary",
            "tool": "core:web_research_summarize",
            "when": {
              "failure_any": [
                "tool_quality",
                "summary_placeholder_text",
                "summary_contains_web_noise",
                "summary_has_ellipsis_truncation",
                "summary_incomplete_sentence",
                "summary_too_short"
              ]
            },
            "action_patch": {
              "strict_sentence_completion": true,
              "strip_web_noise": true,
              "require_source_urls": true,
              "recovery_strategy": "regenerate_clean_summary"
            },
            "rationale": "summary failed quality gates; regenerate concise complete bullets from grounded evidence",
            "priority": 30
          }
        ]
      },
      {
        "id": "windows_app_control",
        "role_agent": "AppControlExecutorAgent",
        "tools": [
          "mcp:windows_open_app",
          "mcp:windows_window_switch",
          "mcp:windows_window_close"
        ],
        "max_attempts": 5,
        "steps": [
          {
            "strategy": "retry_same_path",
            "tool": "$same",
            "when": {
              "failure_any": ["timeout", "temporarily", "busy", "connection", "unverified", "focus", "window", "not found"]
            },
            "action_patch": {
              "recovery_strategy": "retry_same_path"
            },
            "rationale": "transient desktop state can recover with one same-path retry",
            "priority": 10
          },
          {
            "strategy": "switch_existing_window",
            "tool": "mcp:windows_window_switch",
            "when": {
              "failure_any": ["focus", "window", "not found", "unverified"]
            },
            "action_template": {
              "keywords": "$window_hint",
              "timeout": 8.0
            },
            "rationale": "the app may already be running, so try focusing an existing window",
            "priority": 30
          },
          {
            "strategy": "open_app_then_verify",
            "tool": "mcp:windows_open_app",
            "when": {
              "failure_any": ["window", "not found", "launch", "focus", "unverified"],
              "tool_not_contains": ["windows_open_app"]
            },
            "action_template": {
              "app_name": "$app_name",
              "args_json": "[]"
            },
            "rationale": "switch or close failed; try launching/focusing through the app launcher",
            "priority": 40
          },
          {
            "strategy": "longer_timeout_same_tool",
            "tool": "$same",
            "when": {
              "failure_any": ["timeout", "focus", "window", "unverified"]
            },
            "action_patch": {
              "timeout": 12.0,
              "recovery_strategy": "longer_timeout"
            },
            "rationale": "slow desktop state changes may need a longer verification window",
            "priority": 60
          }
        ]
      },
      {
        "id": "windows_file_ops",
        "role_agent": "FileExecutorAgent",
        "tools": [
          "mcp:windows_file_*",
          "core:fs_*"
        ],
        "max_attempts": 5,
        "steps": [
          {
            "strategy": "normalize_path_retry",
            "tool": "$same",
            "when": {
              "failure_any": ["path", "not found", "permission", "unverified"]
            },
            "action_patch": {
              "normalize_path": true,
              "expand_env": true,
              "recovery_strategy": "normalize_path"
            },
            "rationale": "retry with normalized path and environment expansion",
            "priority": 10
          },
          {
            "strategy": "reveal_parent_for_user_confirmation",
            "tool": "mcp:windows_file_reveal_in_explorer",
            "when": {
              "failure_any": ["path", "not found"]
            },
            "action_patch": {
              "reveal_parent": true
            },
            "rationale": "reveal the closest parent folder so the user can confirm the target",
            "priority": 50
          }
        ]
      },
      {
        "id": "generic_tool_retry",
        "role_agent": "ToolExecutionAgent",
        "tools": ["*"],
        "max_attempts": 5,
        "steps": [
          {
            "strategy": "retry_with_backoff_hint",
            "tool": "$same",
            "when": {
              "failure_any": ["timeout", "connection", "temporarily", "busy", "retry", "unverified"]
            },
            "action_patch": {
              "retry_after_ms": 900,
              "recovery_strategy": "retry_with_backoff"
            },
            "rationale": "generic retryable tool failure; retry with an explicit backoff hint",
            "priority": 20
          }
        ]
      }
    ]
  }
}
