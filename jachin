#!/usr/bin/env python3
"""
Jachin CLI 入口脚本
从项目根目录运行: python jachin pair | python jachin daemon | python jachin status
"""
import sys
from pathlib import Path

# 确保 cli 在 path 中（jachin_cli 位于 cli/ 下）
_root = Path(__file__).resolve().parent
_cli = _root / "cli"
if _cli.exists() and str(_cli) not in sys.path:
    sys.path.insert(0, str(_cli))

from jachin_cli.main import main

if __name__ == "__main__":
    sys.exit(main())
