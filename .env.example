# Jachin-System 环境变量配置示例
# 复制此文件为 .env 并修改所需配置
# cp .env.example .env

# ========== 服务 ==========
SERVER_HOST=0.0.0.0
SERVER_PORT=18888
# APP_PORT 若设置则覆盖 SERVER_PORT（Dapr 等场景）
# APP_PORT=18888
DEBUG=true

# ========== 数据库 ==========
# L2 使用 SQLite (~/.jachin/l2_control.db)，以下为 Layer 1 或旧配置
# DATABASE_URL=postgresql://jachin:secure_password@localhost:5432/jachin_brain

# ========== 向量数据库 (Qdrant) - 可选，L2 默认不用 ==========
# QDRANT_URL=http://localhost:6333
# QDRANT_GRPC_URL=http://localhost:6334

# ========== Redis - 可选，L2 默认不用 ==========
# REDIS_URL=redis://localhost:6379

# ========== MQTT ==========
MQTT_BROKER=mqtt://localhost:1883

# ========== LLM ==========
# OpenAI（LiteLLM / gpt-4o-mini 等）
OPENAI_API_KEY=

# 通义千问：三选一即可，优先级：QWEN_AI_API_KEY > DASHSCOPE_API_KEY > QWEN_API_KEY
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_AI_API_KEY=
LLM_PROVIDER=qwen-v2
LLM_MODEL=qwen-max
QWEN_REGION=cn-beijing

# ========== 本地 LLM ==========
LOCAL_LLM_URL=http://localhost:8000
LOCAL_LLM_MODEL=qwen-7b-chat
LOCAL_LLM_API_KEY=

# ========== Layer 1 Cloud ==========
CLOUD_MARKET_URL=https://market.jachin.io
# IPFS 下载网关（Layer 2 拉取 ipfs:// 时使用，默认 ipfs.io）
# IPFS_GATEWAY=https://ipfs.io/ipfs/
CLOUD_AUTH_URL=https://auth.jachin.io
# CLOUD_CLIENT_ID=
# CLOUD_CLIENT_SECRET=
# HOME_DOMAIN_ID=

# ========== 安全 ==========
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ========== 设备 ==========
# DEVICE_ID=
# Layer 3 Sensory WebSocket 端口（默认 18881，避免与 8080 等常用端口冲突）
# SENSORY_WS_PORT=18881

# ========== 语音 (Whisper / TTS / VAD) ==========
# Whisper 模型路径，如 E:\AIModels\whisper
WHISPER_MODEL_PATH=
# 桌面端 VAD 模型根目录（可选）：在此目录下的 vad/silero_vad.onnx 会被使用。
# 例如设为 E:\jachin-system\data 时，将使用 E:\jachin-system\data\vad\silero_vad.onnx
# 不设置时，程序会使用便携目录 _portable_data/vad 或系统数据目录
# JACHIN_VAD_DEBUG_PATH=E:\jachin-system\data
# 阿里云语音（可选）
ALIYUN_APP_KEY=
# 缓存目录，Whisper 会在 $XDG_CACHE_HOME/whisper 查找模型
# XDG_CACHE_HOME=

# ========== Dapr（V2 已废弃，无需配置）==========

# ========== V2 L2 控制面 ==========
# JACHIN_L2_MASTER_KEY=  # L2 API Key 加密存储，生产必须设置
# Admin 面板 /api/v2/admin/* 必需，未设置时返回 503
JACHIN_L2_ADMIN_TOKEN=your-admin-secret-token

# ========== 项目 ==========
# JACHIN_PROJECT_ROOT=
# 技能数据目录，默认 ~/.jachin
# JACHIN_DATA_DIR=

# ========== Sentinel ==========
SENTINEL_TEST_MODE=0

# ========== Ray（V2 已废弃，无需配置）==========

# ========== 技能 ==========
SKILLS_REPO_PATH=./skills_repo
# resource_mount 型 Persona/Memory 只读挂载点
RESOURCES_REPO_PATH=./resources_repo
BRAIN_BASE_URL=http://localhost:18888
SKILL_RUNTIME=docker
SKILL_AUTO_ENABLE=true
SKILL_MAX_CONCURRENT=10
SKILL_DEFAULT_TIMEOUT=300

# ========== 拓扑 (Super Node vs Distributed) ==========
NODE_MODE=standalone
IS_BRAIN_LOCAL=true

# ========== 集群 ==========
CLUSTER_MODE=single
# ENVIRONMENT=
DISCOVERY_METHOD=mdns
# CLUSTER_NODE_ID=
# CLUSTER_NODE_NAME=
CLUSTER_NODE_ROLE=head

# ========== 配置路径 ==========
CLUSTER_CONFIG_PATH=./config/cluster.yaml
SKILLS_CONFIG_PATH=./config/skills_config.yaml

# ========== 日志 ==========
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/jachin.log
LOG_ROTATION=00:00
LOG_RETENTION=10 days
