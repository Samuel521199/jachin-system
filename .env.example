# Jachin-System 环境变量配置示例
# 复制此文件为 .env 并修改所需配置
# cp .env.example .env

# ========== 服务 ==========
SERVER_HOST=0.0.0.0
SERVER_PORT=18888
# APP_PORT 若设置则覆盖 SERVER_PORT（Dapr 等场景）
# APP_PORT=18888
DEBUG=true

# ========== 数据库 ==========
DATABASE_URL=postgresql://jachin:secure_password@localhost:5432/jachin_brain

# ========== 向量数据库 (Qdrant) ==========
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_URL=http://localhost:6334

# ========== Redis ==========
REDIS_URL=redis://localhost:6379

# ========== MQTT ==========
MQTT_BROKER=mqtt://localhost:1883

# ========== LLM（通义千问） ==========
# 三选一即可，优先级：QWEN_AI_API_KEY > DASHSCOPE_API_KEY > QWEN_API_KEY
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_AI_API_KEY=
LLM_PROVIDER=qwen-v2
LLM_MODEL=qwen-max
QWEN_REGION=cn-beijing

# ========== 本地 LLM ==========
LOCAL_LLM_URL=http://localhost:8000
LOCAL_LLM_MODEL=qwen-7b-chat
LOCAL_LLM_API_KEY=

# ========== Layer 1 Cloud ==========
CLOUD_MARKET_URL=https://market.jachin.io
CLOUD_AUTH_URL=https://auth.jachin.io
# CLOUD_CLIENT_ID=
# CLOUD_CLIENT_SECRET=
# HOME_DOMAIN_ID=

# ========== 安全 ==========
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ========== 设备 ==========
# DEVICE_ID=

# ========== 语音 (Whisper / TTS / VAD) ==========
# Whisper 模型路径，如 E:\AIModels\whisper
WHISPER_MODEL_PATH=
# 桌面端 VAD 模型根目录（可选）：在此目录下的 vad/silero_vad.onnx 会被使用。
# 例如设为 E:\jachin-system\data 时，将使用 E:\jachin-system\data\vad\silero_vad.onnx
# 不设置时，程序会使用便携目录 _portable_data/vad 或系统数据目录
# JACHIN_VAD_DEBUG_PATH=E:\jachin-system\data
# 阿里云语音（可选）
ALIYUN_APP_KEY=
# 缓存目录，Whisper 会在 $XDG_CACHE_HOME/whisper 查找模型
# XDG_CACHE_HOME=

# ========== Dapr ==========
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
# Dapr Placement/Scheduler：Docker 已映射到 localhost，使用以下地址可连接
# 若仍出现 scheduler 不可达，设为 skip 可跳过（开发模式无 Actor Reminders 时无害）
DAPR_PLACEMENT_HOST_ADDRESS=localhost:6050
DAPR_SCHEDULER_HOST_ADDRESS=localhost:6060

# ========== 项目 ==========
# 项目根目录（Ray worker 注入用，通常无需手动设置）
# JACHIN_PROJECT_ROOT=
# 技能数据目录，默认 ~/.jachin
# JACHIN_DATA_DIR=

# ========== Sentinel ==========
SENTINEL_TEST_MODE=0

# ========== Ray ==========
RAY_MODE=single
RAY_HEAD_HOST=localhost
RAY_HEAD_PORT=10001
RAY_DASHBOARD_PORT=8265
RAY_DISABLE_USAGE_STATS=true

# ========== 技能 ==========
SKILLS_REPO_PATH=./skills_repo
BRAIN_BASE_URL=http://localhost:18888
SKILL_RUNTIME=docker
SKILL_AUTO_ENABLE=true
SKILL_MAX_CONCURRENT=10
SKILL_DEFAULT_TIMEOUT=300

# ========== 拓扑 (Super Node vs Distributed) ==========
NODE_MODE=standalone
IS_BRAIN_LOCAL=true

# ========== 集群 ==========
CLUSTER_MODE=single
# ENVIRONMENT=
DISCOVERY_METHOD=mdns
# CLUSTER_NODE_ID=
# CLUSTER_NODE_NAME=
CLUSTER_NODE_ROLE=head

# ========== 配置路径 ==========
CLUSTER_CONFIG_PATH=./config/cluster.yaml
RAY_CONFIG_PATH=./config/ray_config.yaml
SKILLS_CONFIG_PATH=./config/skills_config.yaml

# ========== 日志 ==========
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/jachin.log
LOG_ROTATION=00:00
LOG_RETENTION=10 days
