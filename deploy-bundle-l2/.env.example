# L2 部署包 - 环境变量示例
# 复制为 .env 并修改，或启动前用 $env:VAR="value" 设置

# ===== 必需：L1 配对 =====
NEXUS_BASE_URL=http://L1机器IP:3000
NEXUS_INSTANCE_ID=
NEXUS_ACCESS_TOKEN=
NEXUS_L1_USER_ID=

# ===== 必需：L2 密钥（审批 L3、加密存储） =====
# 生产环境必须设置，否则 L3 审批后无法正确下发 Key。可从项目根 .env 复制
JACHIN_L2_MASTER_KEY=
JACHIN_L2_ADMIN_TOKEN=   # 首次启动可自动生成

# ===== 建议：JWT 与 LLM =====
# 不设置会每次重启自动生成，生产建议固定
JWT_SECRET=

# 若 L2 提供聊天/技能/语音等能力，需配置（可从项目根 .env 复制）
DASHSCOPE_API_KEY=
QWEN_API_KEY=
LLM_PROVIDER=qwen-v2
LLM_MODEL=qwen3.5-flash-2026-02-23
TTS_PROVIDER=aliyun

# ===== 可选 =====
# L2_PORT=18888
