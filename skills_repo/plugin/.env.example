# HR 招聘插件 - 环境变量
# 将此文件复制为 .env 并填入 API Key
# Windows: copy .env.example .env
# Linux/Mac: cp .env.example .env

# 阿里百炼 API Key（推荐，三专家分别用不同千问模型）
# 获取: https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# 三专家模型分配（可选，不填则用默认）
# TECH_LEAD_MODEL=qwen3.5-122b-a10b
# HR_BP_MODEL=qwen3.5-plus
# JUDGE_MODEL=qwen3.5-397b-a17b
# 第一漏斗粗筛（可选）
# BRAIN_FILTER_MODEL=qwen3.5-flash-2026-02-23

# Gemini API Key（回退，当 DashScope 不可用时）
# 免费获取: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini 模型（回退时用）
# HR_PLUGIN_LLM_MODEL=gemini-2.0-flash

# 飞书 Lark（自然语言发帖、实时进度汇报、多维表同步、招聘机器人）
# 获取: https://open.feishu.cn/app 或 https://open.larksuite.com (国际版)
LARK_APP_ID=
LARK_APP_SECRET=
# 接收进度卡片的群聊 chat_id 或用户 user_id
LARK_CHAT_ID=
# Lark 多维表格（多 Agent 评审结果同步，可选，不填则用工具默认）
# LARK_APP_TOKEN=RJgcbE9LtaBPILsnttmlS8iHgbf
# LARK_TABLE_ID=tblzQatxI7op9oBp
# 更新日志表（多维表下方的 commit 式记录，可选）
# LARK_LOG_TABLE_ID=tblXXX
# 是否在写入前清空 entire 表（=true 时新数据从第一行开始，招聘流程默认 true；一表多职位时请设 false）
# LARK_REPLACE_ENTIRE_TABLE=true

# Jachin L3 接入：配置后 Lark 消息转发给 L3，由 L3 Agent + MCP 完成
# L3_WS_URL=ws://127.0.0.1:18981/sensory

# 终端-Lark 镜像（终端为主屏，Lark 为副屏同步显示）
# L3 将终端发起的回复推送到此 URL，由 webhook 转发到 Lark（与 lark_bot 同端口）
# LARK_MIRROR_PUSH_URL=http://127.0.0.1:5000/api/mirror-push
