# HR 招聘插件 - 环境变量（仅飞书/数据路径等非 LLM 项）
# 复制为 .env 后按需填写。Windows: copy .env.example .env
# 与 im_channels.yaml、终端 WS 的关系见仓库：docs/L3_LARK_CONFIG_SINGLE_SOURCE.md

# ========== LLM / 百炼（勿在本目录配置）==========
# DashScope Key、主推理模型、编码模型由 **项目根 .env** 或 **L3 进程**（L2 下发 + SecurityContext）统一提供。
# Skill/MCP 通过 core.plugin_llm_identity 读取，插件目录的 DASHSCOPE_API_KEY / LLM_MODEL 不再生效。
# 根目录示例见仓库 /.env.example

# Gemini 仅作百炼不可用时的进程级回退（仍建议在根 .env 配置，勿依赖本文件）
# GEMINI_API_KEY=

# ========== 飞书 Lark ==========
# 获取: https://open.feishu.cn/app 或 https://open.larksuite.com (国际版)
#
# 【通用机器人】L3 默认 util:lark_send_text、终端镜像；用户 open_id 必须与本应用一致，否则报 open_id cross app
LARK_APP_ID=
LARK_APP_SECRET=
# 【HR 招聘专用】多维表、atom_lark_*；与上分离时可填 HR_LARK_*（不填则回退为仅一套 LARK_* 的旧行为）
# HR_LARK_APP_ID=
# HR_LARK_APP_SECRET=
# 群或会话 ID（oc_ 开头）。与终端镜像不一致时优先于镜像注入。
LARK_CHAT_ID=
# 私聊发给「当前用户」时推荐：用户 open_id（ou_ 开头）。飞书发送消息 API 对私聊更推荐 open_id，可与 LARK_CHAT_ID 二选一。
# LARK_USER_OPEN_ID=
# LARK_DM_OPEN_ID=
# 英文名 → 飞书 ou_ 或邮箱，供 util:lark_resolve_user / util:lark_send_text 解析「发给 vivian」
# LARK_DISPLAY_NAME_MAP={"vivian":"ou_xxxxxxxx"}
# 可选：飞书 user_access_token，用于 search/v1/user 按姓名搜索（需开通 contact:user:search 等）
# LARK_FEISHU_USER_ACCESS_TOKEN=
# LARK_APP_TOKEN=
# LARK_TABLE_ID=
# LARK_LOG_TABLE_ID=
# LARK_REPLACE_ENTIRE_TABLE=true

# Jachin L3：Lark 消息转发给 L3 Agent + MCP
# L3_WS_URL=ws://127.0.0.1:18981/sensory
# LARK_MIRROR_PUSH_URL=http://127.0.0.1:5000/api/mirror-push
