{
  "description": "右下角轻量背词、例句精讲、词义查询、翻译和学习统计。",
  "entry": "SKILL.md",
  "id": "com.jachin.skill.english-learning-assistant",
  "item_type": "SKILL",
  "name": "英语助手",
  "package_assets": [
    {
      "from": "clients/desktop/src/components/EnglishVocab/wordBookData.ts",
      "to": "assets/english_vocab/wordBookData.ts"
    },
    {
      "from": "clients/desktop/src/components/EnglishVocab/wordBookDefinitions.ts",
      "to": "assets/english_vocab/wordBookDefinitions.ts"
    },
    {
      "from": "clients/desktop/src/components/EnglishVocab/wordBooks.ts",
      "to": "assets/english_vocab/wordBooks.ts"
    },
    {
      "from": "l3_client/local_mcps/local_translate_mcp/english_example_pack.json",
      "to": "assets/english_vocab/english_example_pack.json"
    }
  ],
  "preserve_user_data": [
    "$JACHIN_HOME/data/english_vocab/state.json",
    "$JACHIN_HOME/data/english_vocab/cache.json",
    "$JACHIN_HOME/data/english_vocab/example_generator_cache.json",
    "$JACHIN_HOME/data/english_vocab/completion_cache.json",
    "localStorage:jachin.english_vocab.lookup_cache.v1",
    "localStorage:jachin.english_vocab.lookup_cache.v2",
    "localStorage:jachin.english_vocab.lookup_cache.v3",
    "localStorage:jachin.english_vocab.lookup_cache.v4",
    "localStorage:jachin.english_vocab.lookup_cache.v5",
    "localStorage:jachin.english_vocab.lookup_cache.v6",
    "localStorage:jachin.english_vocab.lookup_cache.v7",
    "localStorage:jachin.english_vocab.lookup_cache.v8",
    "localStorage:jachin.english_vocab.lookup_cache.v19",
    "localStorage:jachin.english_vocab.lookup_cache.v20",
    "localStorage:jachin.english_vocab.lookup_cache.v21",
    "localStorage:jachin.english_vocab.lookup_cache.v22",
    "localStorage:jachin.english_vocab.lookup_cache.v23",
    "localStorage:jachin.english_vocab.lookup_cache.v24"
  ],
  "required_mcps": [
    "com.jachin.mcp.english-tutor",
    "com.jachin.mcp.local-translate",
    "com.jachin.mcp.english-example-generator"
  ],
  "required_models": [
    "com.jachin.model.opus-mt-en-zh-ct2-int8",
    "com.jachin.model.opus-mt-zh-en-ct2-int8",
    "com.jachin.model.qwen2-5-0-5b-instruct-gguf-q4-k-m"
  ],
  "runtime_tier": "L3_LOCAL",
  "tags": [
    "english",
    "learning",
    "offline",
    "mcp-test",
    "skill-test"
  ],
  "type": "SKILL",
  "version": "1.0.15",
  "recovery_playbook": {
    "targets": [
      {
        "id": "english_learning_lookup_and_card",
        "role_agent": "ToolExecutionAgent",
        "tools": [
          "*english*",
          "*local_translate*"
        ],
        "max_attempts": 5,
        "steps": [
          {
            "strategy": "check_cached_vocab_assets",
            "tool": "english_example_pack_status",
            "when": {
              "failure_any": [
                "example_missing",
                "cache_missing",
                "pack_missing",
                "definition_missing"
              ]
            },
            "action_patch": {
              "include_counts": true,
              "recovery_strategy": "check_cached_vocab_assets"
            },
            "rationale": "verify bundled vocab/example assets before retrying model generation",
            "priority": 10
          },
          {
            "strategy": "warmup_local_translation_for_card",
            "tool": "local_translate_warmup",
            "when": {
              "failure_any": [
                "translation_missing",
                "model_not_ready",
                "cold_start",
                "timeout"
              ]
            },
            "action_patch": {
              "direction": "en-zh",
              "recovery_strategy": "warmup_local_translation_for_card"
            },
            "rationale": "warm translation runtime before retrying word or sentence explanation",
            "priority": 20
          },
          {
            "strategy": "regenerate_card_with_quality_constraints",
            "tool": "english_generate_example_card",
            "when": {
              "failure_any": [
                "template_like",
                "scene_mismatch",
                "bad_example",
                "logic_error"
              ]
            },
            "action_patch": {
              "strict_scene_fit": true,
              "avoid_templates": true,
              "require_chinese_translation": true,
              "recovery_strategy": "regenerate_card_with_quality_constraints"
            },
            "rationale": "regenerate a higher-quality card when the first example feels template-like or semantically wrong",
            "priority": 30
          }
        ]
      }
    ]
  }
}
