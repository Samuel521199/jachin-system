# 复制为 l1.env 后按实际修改（仓库内 l1.env 已加入 .gitignore，勿提交）
# ECS 公网：47.86.39.173  |  PostgreSQL 库：jachin_nexus  用户：jachin

# nexus-host（--profile host）时：库在同机，用 127.0.0.1
DATABASE_URL=postgres://jachin:请修改密码@127.0.0.1:5432/jachin_nexus

# 若只用 bridge 的 nexus 服务（非 host 网络），改为：
# DATABASE_URL=postgres://jachin:请修改密码@host.docker.internal:5432/jachin_nexus

SKIP_AUTH=false
NEXUS_PUBLIC_URL=http://47.86.39.173:3000

