# L1 数据库初始化镜像（迁移 + init-store-schema）
FROM docker.1ms.run/library/node:20-alpine

WORKDIR /app

COPY cloud/nexus/package.json cloud/nexus/package-lock.json* ./
RUN npm ci

COPY cloud/nexus/ ./

# depends_on 已确保 Postgres 就绪，直接执行迁移
CMD ["sh", "-c", "npm run db:push && npx tsx scripts/init-store-schema.ts && echo 'L1 DB init done'"]
