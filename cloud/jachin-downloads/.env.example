# 与 Layer 1 Nexus 共用同一 PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# 本地测试账号（由 npm run seed:test-user 写入库，勿用于生产）
# 默认邮箱 downloads-test@jachin.local，默认密码 JachinDownloadsTest!2026
# SEED_EMAIL=
# SEED_PASSWORD=

# 与 Nexus 一致，生产环境务必设置强随机值（可与 Nexus 相同以便运维统一）
AUTH_SECRET=

# 开发环境默认开启「任意密码登录」；设为 0 可关闭并走真实库校验
# JACHIN_DOWNLOADS_DEV_LOGIN_BYPASS=0

# GitHub OAuth（可选，与 Nexus 相同 ID/Secret 即可；须在 GitHub OAuth App 的
# Authorization callback URL 中增加本站的回调，例如：
# http://localhost:3001/api/auth/callback/github）
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# MinIO / S3 — 与 Nexus desktop 发行一致
DESKTOP_RELEASES_S3_BUCKET=
DESKTOP_RELEASES_S3_ACCESS_KEY=
DESKTOP_RELEASES_S3_SECRET_KEY=
DESKTOP_RELEASES_S3_ENDPOINT=http://127.0.0.1:9000
DESKTOP_RELEASES_S3_REGION=us-east-1
DESKTOP_RELEASES_S3_FORCE_PATH_STYLE=true

# 与 Nexus 一致；热更新 API 鉴权（~/.jachin/nexus_config.json → desktop_update_token）
# DESKTOP_UPDATE_BEARER=

# 本服务公网基址（可选，用于 OAuth callback）
# NEXTAUTH_URL=http://localhost:3001
