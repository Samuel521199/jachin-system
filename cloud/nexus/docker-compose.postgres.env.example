# 供 docker-compose.postgres.yml 使用（复制为 docker-compose.postgres.env 后按需修改）
# 用法:
#   copy docker-compose.postgres.env.example docker-compose.postgres.env
#   docker compose -f docker-compose.postgres.yml --env-file docker-compose.postgres.env up -d
#
# 与 docker-compose.postgres.yml 默认一致：DaoCloud 同步镜像（不经 docker.io，避免 USTC TLS 超时）
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine

# 海外或已稳定直连 Docker Hub 时可改回官方：
# POSTGRES_IMAGE=postgres:16-alpine

# 若 DaoCloud 仍慢，可试：
# POSTGRES_IMAGE=dockerproxy.net/library/postgres:16-alpine
