# Jachin Nexus (Layer 1) 环境变量
# 复制为 .env.local 并填入真实值

# Database (PostgreSQL + Drizzle ORM)
# 本机 Postgres 默认端口 5432；若 Docker 映射为 15432:5432，应写 ...@localhost:15432/...
# 与 docker-compose.postgres.yml 默认一致：用户/密码 postgres/postgres，库名 postgres。
# 容器首次起来后请在 cloud/nexus 执行：npm run db:push（按 schema 建全表；注册/登录依赖 users 等表）。
# 若曾只跑过不完整的 drizzle migrate 而出现「relation does not exist」，仍以 db:push 对齐为准；需清空重来可用 npm run db:fresh（会删库数据，慎用）。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# L2 网页绑定：允许回跳的 L2 URL 前缀（逗号分隔），须覆盖 BRAIN_BASE_URL，例如 http://47.86.39.173:18888
# L2_BRIDGE_ALLOWED_RETURN_PREFIXES=

# 可选：L2 服务端调用「邮箱+密码校验」接口时须携带的共享密钥（与 L2 的 NEXUS_L2_LOGIN_SECRET 一致）；不设则任意可达 L1 的客户端均可调用该校验 API（生产建议开启）
# 同时用于 L2 拉取工作区成员、解析 slug（GET workspace-members、GET l2-gateway/resolve-org）；未配置时上述接口返回 503
# L1_L2_LOGIN_SHARED_SECRET=

# Auth.js v5：会话 JWT 加解密与 getToken 验签。
# 生产 / next start：必填。生成: openssl rand -base64 32
# 本地 next dev：可不填，将使用 auth.config.ts 内置开发占位密钥（切勿用于生产）
AUTH_SECRET=
# 可选：组织魔法邀请 JWT 专用密钥；不设则与 AUTH_SECRET 共用（payload 含 typ=nexus_org_invite）
# NEXUS_ORG_INVITE_SECRET=
# 可选：站点对外根 URL（OAuth callback、部分重定向）。部署到公网时请设为 https://你的域名
# 若设为 http://localhost:3000，用局域网 IP 访问时登录后可能被带到 localhost——可留空（配合 trustHost）
# 或改为实际访问地址，例如 http://192.168.1.10:3000
# AUTH_URL=https://your-nexus.example.com

# 可选：GitHub OAuth（同时设置 ID 与 SECRET 时启用）
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# 可选：Windows 上 next dev 若不想用 webpack 轮询（默认开启以避免 Watchpack 扫描盘符根目录报 EINVAL），设为 0
# NEXUS_WIN_WEBPACK_POLL=0
# 可选：在终端里设为 1 且用 npx next dev，可看到未过滤的 Watchpack 日志（默认 npm run dev 会隐藏已知噪声）
# NEXUS_DEV_SHOW_WATCHPACK=1

# Auth: 设为 true 时跳过登录校验（演示模式）
# SKIP_AUTH=true

# 可选：顶栏「桌面端下载」跳转地址。不设则使用站内 /desktop-downloads（与 Nexus 同一登录态，推荐）
# 若设为独立下载站完整 URL（https://...），将新开标签页且需单独配置该站的 SSO / 代理才能免二次登录
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_HALL_URL=

# 管理员审核：/api/v1/admin/* 与 /dashboard/admin/review 需 X-Admin-Token 或 nexus_admin_token cookie 匹配
NEXUS_ADMIN_SECRET=

# 开发者发布中心：jachin-cli 上传鉴权
# JACHIN_DEV_TOKEN 与 JACHIN_DEV_ID 一一对应，Token 校验通过后使用 developer_id 入库
JACHIN_DEV_TOKEN=
JACHIN_DEV_ID=

# JMP 签名（Forge 发布 .jmp 时必需）
# 生成: node -e "const c=require('crypto');const k=c.generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('PRIVATE:\n'+k.privateKey);console.log('PUBLIC:\n'+k.publicKey)"
JACHIN_PRIVATE_KEY=

# IPFS 去中心化分发（可选）
# 从 https://app.pinata.cloud 获取 JWT
PINATA_JWT=

# IM 网关：Telegram 机器人（进化战役 2）
# 1. 在 Telegram 搜索 @BotFather，发送 /newbot 创建机器人
# 2. 将 Token 填入下方，复制本文件为 .env.local
# 3. 详见 docs/TELEGRAM_TUNNEL_SETUP.md（Ngrok、setWebhook、绑定 Chat ID）
TELEGRAM_BOT_TOKEN=

# ========== 桌面端安装包（私有 MinIO/S3 + 预签名 URL）==========
# 网页 /downloads 与 Tauri 热更新均依赖；未配置时列表可读但无法生成下载链接，updater 返回 503
# DESKTOP_RELEASES_S3_ENDPOINT=http://127.0.0.1:9000
# DESKTOP_RELEASES_S3_REGION=us-east-1
# DESKTOP_RELEASES_S3_BUCKET=jachin-desktop-releases
# DESKTOP_RELEASES_S3_ACCESS_KEY=
# DESKTOP_RELEASES_S3_SECRET_KEY=
# MinIO 等自建 S3 兼容端点一般需 path-style：默认 true；AWS S3 可设为 false
# DESKTOP_RELEASES_S3_FORCE_PATH_STYLE=true

# Tauri 热更新：与 ~/.jachin/nexus_config.json 中 desktop_update_token 一致（非 edge_agents 时必填其一）
# DESKTOP_UPDATE_BEARER=
