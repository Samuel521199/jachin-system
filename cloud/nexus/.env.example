# Jachin Nexus (Layer 1) 环境变量
# 复制为 .env.local 并填入真实值

# Database (PostgreSQL + Drizzle ORM，本地默认 postgres/postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Auth.js v5：会话 JWT 加解密与 getToken 验签（必填）。生成: openssl rand -base64 32
AUTH_SECRET=
# 可选：组织魔法邀请 JWT 专用密钥；不设则与 AUTH_SECRET 共用（payload 含 typ=nexus_org_invite）
# NEXUS_ORG_INVITE_SECRET=
# 可选：生产环境站点 URL（OAuth callback、Cookie secure 等）
# AUTH_URL=https://your-nexus.example.com

# 可选：GitHub OAuth（同时设置 ID 与 SECRET 时启用）
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Auth: 设为 true 时跳过登录校验（演示模式）
# SKIP_AUTH=true

# 管理员审核：/api/v1/admin/* 与 /dashboard/admin/review 需 X-Admin-Token 或 nexus_admin_token cookie 匹配
NEXUS_ADMIN_SECRET=

# 开发者发布中心：jachin-cli 上传鉴权
# JACHIN_DEV_TOKEN 与 JACHIN_DEV_ID 一一对应，Token 校验通过后使用 developer_id 入库
JACHIN_DEV_TOKEN=
JACHIN_DEV_ID=

# JMP 签名（Forge 发布 .jmp 时必需）
# 生成: node -e "const c=require('crypto');const k=c.generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('PRIVATE:\n'+k.privateKey);console.log('PUBLIC:\n'+k.publicKey)"
JACHIN_PRIVATE_KEY=

# IPFS 去中心化分发（可选）
# 从 https://app.pinata.cloud 获取 JWT
PINATA_JWT=

# IM 网关：Telegram 机器人（进化战役 2）
# 1. 在 Telegram 搜索 @BotFather，发送 /newbot 创建机器人
# 2. 将 Token 填入下方，复制本文件为 .env.local
# 3. 详见 docs/TELEGRAM_TUNNEL_SETUP.md（Ngrok、setWebhook、绑定 Chat ID）
TELEGRAM_BOT_TOKEN=
