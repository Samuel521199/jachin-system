# Jachin Nexus (Layer 1) 环境变量
# 复制为 .env.local 并填入真实值

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth: set to true to skip login when Supabase not configured
# SKIP_AUTH=true

# Supabase Auth 配置：
# 1. URL Configuration > Redirect URLs 添加:
#    http://localhost:3000/auth/callback
#    https://your-domain.com/auth/callback
# 2. Providers 启用 GitHub/Google，填入 Client ID 与 Secret
#    详见 docs/OAUTH_SETUP.md

# JMP 签名（Forge 发布 .jmp 时必需）
# 生成: node -e "const c=require('crypto');const k=c.generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('PRIVATE:\n'+k.privateKey);console.log('PUBLIC:\n'+k.publicKey)"
JACHIN_PRIVATE_KEY=

# IPFS 去中心化分发（优先于 Supabase Storage）
# 从 https://app.pinata.cloud 获取 JWT
PINATA_JWT=

# IM 网关：Telegram 机器人（进化战役 2）
# 1. 在 Telegram 搜索 @BotFather，发送 /newbot 创建机器人
# 2. 将 Token 填入下方，复制本文件为 .env.local
# 3. 详见 docs/TELEGRAM_TUNNEL_SETUP.md（Ngrok、setWebhook、绑定 Chat ID）
TELEGRAM_BOT_TOKEN=
