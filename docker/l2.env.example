# 复制为同目录 l2.env 或与 compose 同级 l2.env（勿提交含密钥的 l2.env）
# Docker 内 L2：Redis 由 compose 注入 REDIS_URL，勿改 redis 主机名为 127.0.0.1

# 同机 L1（宿主机 3000）— bridge 网络用 host.docker.internal（邮箱登录 L2 网关时 L2 会请求此地址）
NEXUS_BASE_URL=http://host.docker.internal:3000

# 可选：与 L1 的 L1_L2_LOGIN_SHARED_SECRET 一致时，L2 在「L1 邮箱+密码登录」请求中会带 X-L2-Gateway-Secret
# NEXUS_L2_LOGIN_SECRET=

# 对外暴露的 L2 基址（浏览器 / Nexus 账号登录回跳 / WASM 回调）；须与 L1 上 L2_BRIDGE_ALLOWED_RETURN_PREFIXES 一致
BRAIN_BASE_URL=http://47.86.39.173:18888

# 数据卷内路径（与 compose 中 /data 挂载一致）
JACHIN_L2_DB_PATH=/data/l2_control.db
JACHIN_LANCEDB_PATH=/data/lancedb_data

# 生产请修改
JWT_SECRET=change-me-in-production
SECRET_KEY=change-me-in-production

# 可选：LLM（按需）
# QWEN_API_KEY=
# DASHSCOPE_API_KEY=
