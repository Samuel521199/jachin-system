# 复制为同目录 l1.env 后填写（勿提交 l1.env）
# Docker 内 L1 连「宿主机」上的 PostgreSQL（数据库不跑在容器里）

# 方式 A（推荐，与 compose 默认一致）：宿主机 Postgres 已对 Docker 网桥开放，主机名用 host.docker.internal
DATABASE_URL=postgres://jachin:请修改密码@host.docker.internal:5432/jachin_nexus

# 若使用下方「network_mode: host」的 nexus-host 服务，可改为：
# DATABASE_URL=postgres://jachin:请修改密码@127.0.0.1:5432/jachin_nexus

SKIP_AUTH=false

# 勿在 l1.env 里设置 HOSTNAME：compose.l1.runtime.yml 已固定为 0.0.0.0（避免与系统主机名冲突导致 Next 启动 ENOTFOUND）。
#
# L2「Nexus 账号登录」回跳白名单（逗号分隔 URL 前缀，须含 L2 公网基址，防 open redirect）
# 示例：L2_BRIDGE_ALLOWED_RETURN_PREFIXES=http://你的公网IP:18888,https://l2.example.com
# L2_BRIDGE_ALLOWED_RETURN_PREFIXES=

# 浏览器请用「公网 IP 或域名 + 端口」，不要打开 http://0.0.0.0:3000（不是站点地址，易 503 / 跳转异常）。
# 配好后 L1 会把误访 0.0.0.0 的请求重定向到此处（须与浏览器地址一致）。
# NEXUS_PUBLIC_URL=http://你的公网IP或域名:3000

# Auth.js / NextAuth 生产环境必填，否则日志 MissingSecret、中间件报错
# 生成示例: openssl rand -base64 32
AUTH_SECRET=

# 可选，与 NEXUS_PUBLIC_URL 一致时可显式设置规范绝对 URL（见 Auth.js AUTH_URL）
# AUTH_URL=http://你的公网IP或域名:3000

# NEXUS_ADMIN_SECRET=
# 其余见 cloud/nexus/.env.example
