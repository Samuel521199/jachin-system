# 复制本文件为 fb_report_nexus.env 并填写；勿将 fb_report_nexus.env 提交到 Git。
# LARK_* 亦可由系统环境变量覆盖（优先级：环境变量 > 本文件）。

# CDP 连接目标（Chrome 远程调试端口入口）
# 架构：脚本运行机器 → Ngrok 公网隧道 → 目标机器（菲律宾，Chrome --remote-debugging-port=9223，已登录 FB）
# 目标机器启动 Ngrok：ngrok http 9223 --host-header=localhost
# 将 Ngrok 控制台输出的公网 URL 填入此处：
FB_REPORT_CDP_URL=https://your-ngrok-url.ngrok-free.app

# FB Ads Manager 报表区间：通过 URL 参数 ``date`` / ``insights_date``（``START_END,preset``）；默认 last_7d
# 日报推荐使用 yesterday（抓昨日数据）
FB_REPORT_PRESET=yesterday

# 可选：Ngrok/CDP 很慢时调大（脚本见顶部文档字符串默认值）
# FB_REPORT_DISPATCH_TIMEOUT_SEC=240
# FB_REPORT_DOWNLOAD_TIMEOUT_MS=90000
# FB_REPORT_EXPORT_FOLLOWUP_SEC=18
# FB_REPORT_SKIP_HOLOGRAM=1
# FB_REPORT_DEBUG_MIN_REMAINING_SEC=50
# FB_REPORT_EVALUATE_TIMEOUT_SEC=25
# FB_REPORT_DEBUG_SCREENSHOT_MS=45000
# FB_REPORT_FALLBACK_LOCATOR_WAIT_MS=20000

LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 接收方类型：email | open_id | user_id | chat_id（群发会话推荐 chat_id）| union_id
LARK_RECEIVE_ID_TYPE=chat_id
# 单一 chat_id / open_id / email 等（与 LARK_RECEIVE_ID_TYPE 一致）
LARK_RECEIVER_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 多人：英文逗号分隔（覆盖 LARK_RECEIVER_ID）；可与 chat_id 混用（视类型而定）
# LARK_RECEIVER_IDS=oc_aaa,oc_bbb
