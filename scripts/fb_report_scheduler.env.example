# FB 广告日报调度器配置
# 复制本文件为 fb_report_scheduler.env 并填写；勿将 fb_report_scheduler.env 提交到 Git。
# 环境变量优先级：系统环境变量 > fb_report_scheduler.env > 代码默认值。
#
# 同目录的 fb_report_nexus.env 仍需配置 Lark 凭证和 FB 抓取参数；
# 本文件仅控制调度器自身行为。

# ─────────────────────────────────────────────
# 调度时间（本地时间 HH:MM）
# ─────────────────────────────────────────────
# 每天发送日报的时刻。调度器启动后每 FB_SCHED_RETRY_INTERVAL_MIN 分钟
# 也会检查当日是否已发送，未发则自动补偿重试。
# 时区固定为 UTC+8（Asia/Kuala_Lumpur，马来西亚/菲律宾/新加坡时间）
# 无论部署机器在哪个时区，08:00 始终对应 MYT 早上 8 点
FB_SCHED_TIME=08:00

# 发送窗口截止时间：超过此时间当日不再重试（即使报告未发出）
# 08:00 触发后若一直失败，最晚重试到 10:00，之后停止
FB_SCHED_WINDOW_END=10:00

# ─────────────────────────────────────────────
# 重试策略
# ─────────────────────────────────────────────
# 失败后多少分钟重试一次（补偿轮询间隔）
FB_SCHED_RETRY_INTERVAL_MIN=15

# 每日最大重试次数（不含首次），超出后停止当日自动重试并发 Lark 告警
FB_SCHED_MAX_RETRIES=10

# 重试耗尽后是否发 Lark 告警（1=开启，0=关闭）
FB_SCHED_ALERT_ON_EXHAUST=1

# ─────────────────────────────────────────────
# 脚本路径（通常无需修改）
# ─────────────────────────────────────────────
# fb_report_nexus.py 的绝对或相对路径（默认同目录）
# FB_SCHED_NEXUS_SCRIPT=/path/to/fb_report_nexus.py

# ─────────────────────────────────────────────
# CDP 连接（透传给 fb_report_nexus.py）
# ─────────────────────────────────────────────
# 架构：脚本运行机器 → Ngrok 公网隧道 → 目标机器（菲律宾，Chrome 9223，已登录 FB）
# 在目标机器（菲律宾）上运行：
#   1. & "C:\Program Files\Google\Chrome\Application\chrome.exe" --remote-debugging-port=9223 --user-data-dir="C:\ChromeProfile_FB"
#   2. ngrok http 9223 --host-header=localhost
# 将 Ngrok 控制台输出的公网 URL 填入此处（与 fb_report_nexus.env 保持一致）：
FB_REPORT_CDP_URL=https://your-ngrok-url.ngrok-free.app

# ─────────────────────────────────────────────
# 抓取区间（透传给 fb_report_nexus.py）
# ─────────────────────────────────────────────
# 日报推荐使用 yesterday（抓取昨日数据）
# 其他可选值：today, last_7d, last_14d, last_30d, this_month, last_month, YYYY-MM-DD
FB_REPORT_PRESET=yesterday
