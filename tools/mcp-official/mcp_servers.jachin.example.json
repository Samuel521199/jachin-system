{
  "mcp_servers": [
    {
      "id": "official-fetch",
      "name": "MCP Fetch（官方参考）",
      "command": "python",
      "args": ["-m", "mcp_server_fetch"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "official-time",
      "name": "MCP Time（官方参考）",
      "command": "python",
      "args": ["-m", "mcp_server_time"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "official-git",
      "name": "MCP Git（官方参考）",
      "command": "python",
      "args": [
        "-m",
        "mcp_server_git",
        "--repository",
        "REPLACE_WITH_GIT_REPO_ROOT"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "official-filesystem",
      "name": "MCP Filesystem（官方 npm，需 Node）",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@0.6.2",
        "REPLACE_WITH_ALLOWED_DIR_1",
        "REPLACE_WITH_ALLOWED_DIR_2"
      ]
    },
    {
      "id": "official-mcp-fetch",
      "name": "MCP Fetch（PyPI mcp-server-fetch；npm @modelcontextprotocol/server-fetch 常不可用）",
      "command": "__JACHIN_MCP_PYTHON__",
      "args": ["-m", "mcp_server_fetch"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "official-sqlite-npx",
      "name": "MCP SQLite（npm mcp-sqlite；勿用 @modelcontextprotocol/server-sqlite，npm 404）",
      "command": "npx",
      "args": ["-y", "mcp-sqlite", "__JACHIN_WORKSPACE__/test_db.sqlite"]
    },
    {
      "id": "sqlite_manager",
      "name": "SQLite 生活库 / 记账（PyPI mcp-server-sqlite，uvx；与 official-sqlite-npx 二选一即可）",
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "__JACHIN_WORKSPACE__/my_life_data.db"
      ]
    },
    {
      "id": "official-memory-npx",
      "name": "MCP Memory（官方 npx，知识图谱）",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    {
      "id": "tavily-search",
      "name": "Tavily Search（npm: tavily-mcp，需 TAVILY_API_KEY）",
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    {
      "id": "maps_assistant",
      "name": "Google Maps MCP（地理编码、路线、周边；@modelcontextprotocol/server-google-maps）",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-google-maps"],
      "env": {
        "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}"
      }
    },
    {
      "id": "playwright-browser-npx",
      "name": "MCP Playwright（最新版浏览器操控）",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  ]
}
