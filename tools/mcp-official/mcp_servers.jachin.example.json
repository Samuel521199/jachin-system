{
  "mcp_servers": [
    {
      "id": "official-fetch",
      "name": "MCP Fetch（官方参考）",
      "command": "python",
      "args": ["-m", "mcp_server_fetch"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "official-time",
      "name": "MCP Time（官方参考）",
      "command": "python",
      "args": ["-m", "mcp_server_time"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "official-git",
      "name": "MCP Git（官方参考）",
      "command": "python",
      "args": [
        "-m",
        "mcp_server_git",
        "--repository",
        "REPLACE_WITH_GIT_REPO_ROOT"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "official-filesystem",
      "name": "MCP Filesystem（官方 npm，需 Node）",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "REPLACE_WITH_ALLOWED_DIR_1",
        "REPLACE_WITH_ALLOWED_DIR_2"
      ]
    },
    {
      "id": "official-fetch-npx",
      "name": "MCP Fetch（官方 npx，网页阅读）",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    {
      "id": "official-sqlite-npx",
      "name": "MCP SQLite（官方 npx，压测库）",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "--db-path",
        "__JACHIN_WORKSPACE__/test_db.sqlite"
      ]
    },
    {
      "id": "official-memory-npx",
      "name": "MCP Memory（官方 npx，知识图谱）",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    }
  ]
}
