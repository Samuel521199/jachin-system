{
  "mcp_servers": [
    {
      "id": "official-fetch",
      "name": "MCP Fetch（官方参考）",
      "command": "python",
      "args": ["-m", "mcp_server_fetch"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "official-time",
      "name": "MCP Time（官方参考）",
      "command": "python",
      "args": ["-m", "mcp_server_time"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "official-git",
      "name": "MCP Git（官方参考）",
      "command": "python",
      "args": [
        "-m",
        "mcp_server_git",
        "--repository",
        "REPLACE_WITH_GIT_REPO_ROOT"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "official-filesystem",
      "name": "MCP Filesystem（官方 npm，需 Node）",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "REPLACE_WITH_ALLOWED_DIR_1",
        "REPLACE_WITH_ALLOWED_DIR_2"
      ]
    },
    {
      "id": "official-fetch-npx",
      "name": "MCP Fetch（Python stdio；npm @modelcontextprotocol/server-fetch 在 registry 不可用，请用 PyPI mcp-server-fetch）",
      "command": "python",
      "args": ["-m", "mcp_server_fetch"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "id": "official-sqlite-npx",
      "name": "MCP SQLite（npm mcp-sqlite；勿用 @modelcontextprotocol/server-sqlite，npm 404）",
      "command": "npx",
      "args": ["-y", "mcp-sqlite", "__JACHIN_WORKSPACE__/test_db.sqlite"]
    },
    {
      "id": "official-memory-npx",
      "name": "MCP Memory（官方 npx，知识图谱）",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    {
      "id": "tavily-search",
      "name": "Tavily Search（npm: tavily-mcp，需 TAVILY_API_KEY）",
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    {
      "id": "playwright-browser-npx",
      "name": "MCP Playwright（最新版浏览器操控）",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  ]
}
