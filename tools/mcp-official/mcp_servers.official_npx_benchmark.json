{
  "mcp_servers": [
    {
      "id": "official-mcp-fetch",
      "name": "MCP Fetch（官方 mcp-server-fetch，与 npx 包名无关）",
      "command": "__JACHIN_MCP_PYTHON__",
      "args": ["-m", "mcp_server_fetch"],
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "id": "official-sqlite-npx",
      "name": "MCP SQLite（npm mcp-sqlite，压测库）",
      "command": "npx",
      "args": [
        "-y",
        "mcp-sqlite",
        "__JACHIN_WORKSPACE__/test_db.sqlite"
      ]
    },
    {
      "id": "official-memory-npx",
      "name": "MCP Memory（官方 npx，知识图谱）",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    }
  ]
}
