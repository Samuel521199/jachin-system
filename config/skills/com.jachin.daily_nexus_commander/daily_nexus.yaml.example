# Daily Nexus Commander — 本地配置示例
# 复制到: ~/.jachin/config/skills/com.jachin.daily_nexus_commander/daily_nexus.yaml

weather_city: "上海"

# 详细运行日志目录（默认 Windows: %USERPROFILE%\.jachin\jachin_debug\健康skill）；也可用环境变量 DAILY_NEXUS_LOG_DIR
# log_dir: ""
# log_level: DEBUG
# log_copy_latest: false

# 可选：今日欲注册的桌面提醒（须 Jachin 桌面端运行）
reminders:
  - title: "喝水"
    body: "起来活动 2 分钟"
    fire_at_iso: "2026-04-09T10:30:00+08:00"
  # - body: "例会前 5 分钟"
  #   delay_seconds: 3600

# 可选：SQLite 只读探针（表名须与你 my_life_data.db 中一致；不对则删掉避免报错）
sqlite_snippets:
  - name: "昨日记账笔数"
    sql: "SELECT COUNT(*) AS n FROM transactions WHERE date(created_at) = date('now','-1 day');"
  # - name: "待办未完成"
  #   sql: "SELECT COUNT(*) AS n FROM todos WHERE done = 0;"

# 投递偏好：lark | email | reply_only
notify_channel: "reply_only"
