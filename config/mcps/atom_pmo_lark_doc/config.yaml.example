# atom_pmo_lark_doc — PMO/BMO Lark（默认 K11 三表 + 按日落盘）
# 复制为 config/mcps/atom_pmo_lark_doc/config.yaml 或 ~/.jachin/config/mcps/atom_pmo_lark_doc/config.yaml

app_id: "${LARK_APP_ID}"
app_secret: "${LARK_APP_SECRET}"
lark_use_feishu: true

# 为 true 且未配置 wiki_urls 时，使用内置三条 K11 Wiki 链接（需求池 / 项目进度 / 美术设计）
use_k11_default_tables: true

# 为 true 时输出目录：docs/pmo_bmo_plugin/project_progress_daily/YYYY-MM-DD/
daily_snapshot: true
# snapshot_date: "2026-03-30"

# daily_snapshot: false 时可用固定目录，例如：
# output_dir_relative: docs/pmo_bmo_plugin/synced

max_records_per_table: 2000
max_discovered_links: 40
recurse_children_depth: 2

# 非空则覆盖默认三表（与飞书应用权限、知识空间成员一致）
# wiki_urls:
#   - "https://ssgkm409t6q5.sg.larksuite.com/wiki/..."

# list_nodes 可选默认空间
# space_id: ""
