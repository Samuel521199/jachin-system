# atom_bi_project_context — 将 Lark 知识库中的 BI 项目文档同步到仓库 docs/bi_daily_report/bi_project/
# 复制为 config/mcps/atom_bi_project_context/config.yaml 或写入 ~/.jachin/config/mcps/atom_bi_project_context/config.yaml
#
# 要求：自建应用开通 知识库、云文档(docx)、电子表格、多维表格 等只读权限；应用须加入对应知识空间成员。
# 参考：https://open.larksuite.com/document/server-docs/docs/wiki-v2/wiki-qa

app_id: "${LARK_APP_ID}"
app_secret: "${LARK_APP_SECRET}"
lark_use_feishu: false
output_dir_relative: docs/bi_daily_report/bi_project
# 单表/单视图分页拉取上限（硬顶见 JACHIN_BITABLE_RECORD_HARD_CAP）；与 URL 中 view= 组合，各视图单独落盘
max_records_per_table: 50000
max_discovered_links: 40
recurse_children_depth: 2

# PMO：以下 Wiki node_token 前缀不参与同步（种子 / 子页面 / docx 内链均跳过），减少辅助表落盘与记忆噪声；与 skills_repo/pmo-copilot/SKILL.md「排除表」一致
wiki_node_skip_tokens:
  - JfyTwbuQ # 包体优化任务文档
  - YyjEwhK6 # K11 正式服账号
  - BrC4wrJi # bundle 修改前后大小表
  - X0OgwYvI # 资源优化任务协作分工状态及处理后数据汇总
  - XlUMwIbP # 平台问题反馈
  - RqskwRfZ # 平台近期工作计划
  - ZxpDw9yM # 本地化翻译优化
  - E4ZbwlNd # 0.2 结版方案
  - IPJLw1LB # 第二期优化方案
  - CvGfw6dS # 待讨论问题
  - TO3twkDP # 测试记录

# 可选：覆盖内置种子链接（默认见 l3_node/.../tool_bi_project_context.py::_default_wiki_urls；
# 默认已不含「测试记录」种子；PMO 完整清单见 skills_repo/pmo-copilot/SKILL.md §1.1）
wiki_urls:
  - https://ssgkm409t6q5.sg.larksuite.com/wiki/ZItbw4omRi6Sbsksb6jlwYq8gYq?table=tblozlbpzHlL8m8m&view=vew8TxMcSh
  - https://ssgkm409t6q5.sg.larksuite.com/wiki/GdQ7wTgSRiZ0olkXrNGlFcz0gad?table=tblhJN0G2EhRNwjZ&view=vewpI8lyYw
  - https://ssgkm409t6q5.sg.larksuite.com/wiki/DiSnwVB1OiDvPWkk0W9lzx6AgLd?table=tblDw87UlhddFIoY&view=vew5taB9H1
  - https://ssgkm409t6q5.sg.larksuite.com/wiki/HS8qw9XvDiN7u3kolkOlEplCgvb?sheet=3045da
  - https://ssgkm409t6q5.sg.larksuite.com/wiki/FxOlwGQOniz5H2k5qiYl4Fzgggb?sheet=eIdFLx
  - https://ssgkm409t6q5.sg.larksuite.com/wiki/UVR8wY8NUiyItnkA5dal4De7gUh
