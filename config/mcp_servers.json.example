{
  "mcp_servers": [
    {
      "id": "tavily-search",
      "name": "Tavily Search（联网检索，官方 MCP）",
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
  ],
  "_comment": "复制到 ~/.jachin/mcp_servers.json 并与仓库 tools/mcp-official/mcp_servers.jachin.example.json 按需合并。${TAVILY_API_KEY} 在 L3 拉起 MCP 时从进程环境展开（见 .env / 系统环境变量）。Windows 下 npx 由 MCP 宿主解析为 npx.cmd。"
}
