{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "version", "runtime", "capabilities"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Skill ID (e.g., com.jachin.sys-monitor). If not provided, will be generated from name and version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "enum": ["MIT", "Apache-2.0", "GPL-3.0", "proprietary"]
    },
    "runtime": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["docker", "wasm", "native", "ray"]
        },
        "image": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["action", "sensor", "processor"]
          },
          "description": {
            "type": "string"
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "memory": {
          "type": "string"
        },
        "gpu": {
          "type": "boolean"
        },
        "disk": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["scope"],
            "properties": {
              "scope": { "type": "string" }
            }
          }
        ]
      }
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "install": {
          "type": "string"
        },
        "uninstall": {
          "type": "string"
        },
        "health_check": {
          "type": "string"
        }
      }
    }
  }
}
