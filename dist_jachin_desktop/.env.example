# Jachin-System 环境变量配置示例
# 复制此文件为 .env 并修改所需配置
# cp .env.example .env
#
# 与便携 / Desktop 基线 .env 合并时：同名键以基线为准；仓库可多出的键见 BI_*、HTTP(S)_PROXY、JACHIN_L2_ADMIN_TOKEN 等。
# 桌面安装包打入 .env：无 JACHIN_DESKTOP_BUNDLE_ENV_FILE 与 clients/desktop/.jachin_bundle_env_path 时，
# 优先复制仓库根 .env（若存在），否则复制本文件。详见 clients/desktop/jachin_bundle_env_path.example。

# ========== 服务 ==========
SERVER_HOST=0.0.0.0
SERVER_PORT=18888
# APP_PORT 若设置则覆盖 SERVER_PORT
# APP_PORT=18888
DEBUG=true

# ========== 数据库 ==========
# L2 使用 SQLite (~/.jachin/l2_control.db)
# Layer 1 (Nexus) 使用 PostgreSQL，本地默认 postgres/postgres
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ========== 向量存储 (LanceDB 本地目录，默认见 core.config.LANCEDB_PATH) ==========
# LANCEDB_PATH=data/lancedb
# 或统一数据目录：JACHIN_DATA_DIR=~/.jachin  （LanceDB 落在其下 lancedb_data，见 core.db.l2_memory_lancedb）

# ========== Redis - 可选，L2 默认不用 ==========
# REDIS_URL=redis://localhost:6379

# ========== MQTT ==========
MQTT_BROKER=mqtt://localhost:1883

# ========== LLM ==========
# OpenAI（LiteLLM / gpt-4o-mini 等）
OPENAI_API_KEY=

# ---------- Kalaroko 巡检中枢 · 飞书自建应用 Open API（可选）----------
# 巡检完成后向群内发「交互式卡片 + 话题回复盖楼」；需 FEISHU_APP_SECRET 等。未配置则跳过推送。
# （完整 CDP / MCP / 调度相关变量见下文「巡检中枢 · Kalaroko E2E / MCP / 定时任务」小节）
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=   # 必填；勿提交 Git，仅本机或 CI Secret
# FEISHU_CHAT_ID=oc_xxxxxxxx
# 巡检报告「巡检时间」展示时区（captured_at 按 UTC 解析后换算）：utc8=北京时间(UTC+8) | malaysia=马来西亚时间(UTC+8)
# KALAROKO_REPORT_TZ=utc8
# KALAROKO_REPORT_TZ=malaysia

# ---------- DashScope 区域（国内 CN / 东南亚 SEA）----------
# Kalaroko 多轮 E2E 结尾分析、LLM_COMPLEX_MODEL 与 L3 共用：按 JACHIN_ACTIVE_REGION 选 Key 与 endpoint
# 详见 docs/DASHSCOPE_REGIONAL_KEYS.md
# JACHIN_ACTIVE_REGION=CN
# DASHSCOPE_API_KEY_CN=
# DASHSCOPE_API_KEY_SEA=
# DASHSCOPE_API_BASE_CN=
# DASHSCOPE_API_BASE_SEA=

# 通义千问（通用回退）：QWEN_AI_API_KEY > DASHSCOPE_API_KEY > QWEN_API_KEY；未配置 _CN/_SEA 时使用
# L3 终端/桌面端发消息需有效 DashScope 或 OPENAI Key；打包/便携可将 .env 复制到 ~/.jachin/.env
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_AI_API_KEY=
LLM_PROVIDER=qwen-v2
# 推理/分析主模型（百炼/DashScope）— 与 GitHub v0.8.56（同事侧系统默认）一致
LLM_MODEL=qwen3.5-plus
# 编码任务（如 delegate 子 Agent role=coder）；可选，默认 qwen3-coder-plus（v0.8.56）
# LLM_CODER_MODEL=qwen3-coder-plus
# LLM 请求超时秒数，默认 180（大模型响应较慢时可调高）
# LLM_TIMEOUT=180
QWEN_REGION=cn-beijing
# 主模型失败时的降级模型，逗号分隔。已配置任一 DashScope Key（含 _CN/_SEA 或通用）时默认可用经济型 flash，否则 ollama/qwen2.5
# LITELLM_FALLBACK_MODELS=dashscope/qwen3.5-flash
# BI/低成本场景可选用（与上方 plus 二选一）：LLM_MODEL=qwen3.5-flash

# 复杂推理 / 巡检中枢 Kalaroko 多轮 E2E 末尾分析与 24h 晨报（scripts/test_kalaroko_default_scenarios_e2e.py；未设默认 qwen3-max）
# LLM_COMPLEX_MODEL=qwen3-max

# 意图网关专用（与 ReAct 主模型 LLM_MODEL 独立）：小模型默认 qwen-turbo，多模态默认 qwen-vl-max；亦可 ~/.jachin/nexus_config.json → intent_gateway.classification_model / multimodal_model
# INTENT_GATEWAY_CLASSIFICATION_MODEL=qwen-turbo
# INTENT_GATEWAY_MULTIMODAL_MODEL=qwen-vl-max
# 向量路由（需 DASHSCOPE 或 OPENAI Key + litellm；默认关闭）
# INTENT_GATEWAY_EMBEDDING_MODEL=dashscope/text-embedding-v1
# nexus intent_gateway.embedding_router_enabled=true 时生效
# 负反馈 jsonl：intent_gateway.flywheel_feedback_enabled=true
# 环境嗅探（Context Sniffer）默认不在入站阶段调用 Chroma；若确需旧行为：~/.jachin/nexus_config.json → intent_gateway.context_sniffer_memory_chroma_enabled = true

# ========== 本地 LLM ==========
LOCAL_LLM_URL=http://localhost:8000
LOCAL_LLM_MODEL=qwen-7b-chat
LOCAL_LLM_API_KEY=

# ========== 代理（可选：访问外网 / YouTube / DashScope 等需翻墙时）==========
# L3、LiteLLM、MCP 子进程（如 youtube-transcript 的 env 里 ${HTTP_PROXY}）会用到。
# 端口以你本机代理软件为准：Clash 常见 7890；QuickQ 请在客户端查看「http」端口（例如 8800）。
# HTTP_PROXY=http://127.0.0.1:8800
# HTTPS_PROXY=http://127.0.0.1:8800
# 代理未启动时 LiteLLM 会报「拒绝连接」：注释上两行，或设 JACHIN_LLM_IGNORE_HTTP_PROXY=1（L3 LLM 始终直连，不走 HTTP(S)_PROXY）
# 若应用只认小写（少数环境）：# http_proxy= 与 # https_proxy= 可与上面保持一致

# ========== MCP · stdio（L3 读 ~/.jachin/mcp_servers.json）==========
# 已配对 L2 且 permissions_snapshot.allowed_skills 非空时，未列名的 mcp: 工具会在工具池合并阶段被剔除。
# 设为 1 将 mcp:* 并入白名单，放行已在 mcp_servers.json 注册的 MCP（K11 / Puppeteer / browser-use 等）。见 l3_node/primitives/tools/tool_pool.py
# JACHIN_MERGE_LOCAL_MCP_INTO_TOOL_POOL=1
# Bilibili（@xzxzzx/bilibili-mcp）：须登录态 Cookie，否则 get_video_info 会报字幕为空/Cookie 失效
# 浏览器已登录 bilibili.com → F12 → Application → Cookies → https://www.bilibili.com
# 复制 SESSDATA、bili_jct、DedeUserID 的值填到下方（勿提交 Git；可写在 ~/.jachin/.env）
# BILIBILI_SESSDATA=
# BILIBILI_BILI_JCT=
# BILIBILI_DEDEUSERID=
# Tavily Search：npx -y tavily-mcp@latest（npm 包名 tavily-mcp）；示例见 config/mcp_servers.json.example
# 勿将真实 Key 提交到 Git；配置文件中写 "TAVILY_API_KEY": "${TAVILY_API_KEY}" 即可从本处注入
# TAVILY_API_KEY=
# Tavily 排障日志 [TavilyMCP][chain]/[invoke]（默认开启）；关闭噪音：JACHIN_LOG_TAVILY_CHAIN=0

# Google Maps MCP（maps_assistant，npm @modelcontextprotocol/server-google-maps；出行/线下感知）
# 密钥在 Google Cloud Console 创建 Maps Platform API Key；勿提交到 Git
# GOOGLE_MAPS_API_KEY=
# 可选别名（与 GOOGLE_MAPS_API_KEY 二选一；启动时会合并到 GOOGLE_MAPS_API_KEY 供子进程使用）
# Maps_API_KEY=

# Puppeteer MCP（official-mcp-puppeteer，npm @modelcontextprotocol/server-puppeteer）
# 若已安装本机 Chrome，可指向 chrome.exe，避免 npx puppeteer browsers install 下载整包（路径按你机器修改）：
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# 注意：仅写「系统环境变量」后需**新开终端**；仅写在本 .env 时，L3 会 merge_dotenv，测试脚本 test_puppeteer_mcp_herontest.py 也会加载本文件。
# 使用 L3 MCP 时，还须在 ~/.jachin/mcp_servers.json 的 official-mcp-puppeteer 条目中增加同名 env，子进程才会带上。
# 需本机 Node + npx。Windows 建议在 mcp_servers.json 用 cmd.exe /c npx …（见 config/mcp_servers.json.example）。
# Browser-Use MCP（browser-use，config 中 uvx browser-use --mcp）：至少配置其一
# OPENAI_API_KEY=   （或与上方 LLM 区共用）
# ANTHROPIC_API_KEY=
# BROWSER_USE_HEADLESS=true
# BROWSER_USE_LOGGING_LEVEL=INFO
#
# ---------- 附加本机已开 Chrome（CDP，K11 / 冒烟 / 手工调试）----------
# DevTools HTTP 根（browser-use 配置里 cdp_url；与 K11 脚本 --cdp-http 一致）
# K11_CDP_HTTP=http://127.0.0.1:9222
# 指向「含 browser_profile.*.cdp_url 的 JSON」；L3 merge 本 .env 后，mcp_servers.json 里
# "BROWSER_USE_CONFIG_PATH": "${BROWSER_USE_CONFIG_PATH}" 才能展开为有效路径。
# Windows 示例用户（请按实际用户名改盘符与目录；或用 %USERPROFILE% 在「系统环境变量」里配置）：
# BROWSER_USE_CONFIG_PATH=C:\Users\Samuel\.jachin\runtime\browser-use-attach-cdp.json
# 与仓库 core/mcp_embedded_runtime 默认查找路径一致时可省略；否则指定自定义 JSON 路径：
# JACHIN_BROWSER_USE_ATTACH_CONFIG=C:\Users\Samuel\.jachin\runtime\browser-use-attach-cdp.json
# K11 脚本仅文案用站点（不发起导航）：
# K11_BROWSER_CONTEXT_URL=https://www.kalaroko.com/
# L3 HTTP（run_k11_p1_modules_l3.py 默认）：
# JACHIN_L3_HTTP_BASE=http://127.0.0.1:18991
# 可选：开发机对 /api/v3/mcp/execute 做 browser_get_state 预检时
# JACHIN_L3_MCP_EXECUTE_ALLOW_LEGACY=1
#
# 配置文件关系（须重启 L3 后 MCP 子进程才生效）：
#   1) %USERPROFILE%\.jachin\runtime\browser-use-attach-cdp.json — cdp_url 本体（可由 python scripts/run_k11_p1_modules_l3.py 自动生成）
#   2) 仓库根 .env 或 %USERPROFILE%\.jachin\.env — 提供 BROWSER_USE_CONFIG_PATH 等，供 merge_l3_dotenv_into_os
#   3) %USERPROFILE%\.jachin\mcp_servers.json — browser-use 条目的 env；可与 (2) 二选一或互为备份

# ========== Layer 1 Cloud ==========
CLOUD_MARKET_URL=https://market.jachin.io
# IPFS 下载网关（Layer 2 拉取 ipfs:// 时使用，默认 ipfs.io）
# IPFS_GATEWAY=https://ipfs.io/ipfs/
CLOUD_AUTH_URL=https://auth.jachin.io
# CLOUD_CLIENT_ID=
# CLOUD_CLIENT_SECRET=
# HOME_DOMAIN_ID=

# ========== 安全 ==========
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ========== PMO 打包机（编辑安装根目录 .env · 与 Jachin Desktop.exe 同级）==========
# 飞书自建应用（PMO 战报推送 / 多维表拉取 / 长连接机器人可共用同一应用）
LARK_APP_ID=
LARK_APP_SECRET=

# 战报推送（core:pmo_macro_dashboard_push）
PMO_PRIMARY_CHAT_ID=
PMO_MONITOR_CHAT_ID=oc_0e321f92d758ecb44aea5b499c90510b
PMO_PUSH_MONITOR=1

# 变更预警（pmo_bitable_watch / core:pmo_change_alert_analyze）
PMO_CHANGE_ALERT_CHAT_ID=oc_b1b9cff6804517c79b7f5a617ab30483
PMO_CHANGE_ALERT_MONITOR_CHAT_ID=oc_0e321f92d758ecb44aea5b499c90510b

# ========== Lark / 飞书（其它 IM / MCP；PMO 凭证见上一节） ==========
# 获取: https://open.feishu.cn/app 或 https://open.larksuite.com (国际版)
# 长连接开关与 chat_ids 白名单：~/.jachin/config/im_channels.yaml 或 Desktop「设置 → 飞书长连接」
# LARK_CHAT_ID=              # Agent 调 util:lark_send_text 未传 chat_id 时的默认会话
# LARK_APP_TOKEN=             # 多维表同步（可选）
# LARK_TABLE_ID=              # 多维表 ID（可选）
# 兼容旧键名（未设 PMO_CHANGE_ALERT_* 时变更预警可读下列项）
# PMO_BITABLE_WATCH_CHAT_ID=
# PMO_BITABLE_WATCH_MONITOR_CHAT_ID=

# PMO：K11「需求表3月」云文档 token（/docx/<token>）；不设则使用 main_skill 内置默认
# PMO_REQ_MARCH_COARSE_DOCX_ID=ZcpedCREaoNrQUxvM7EluZGugWg
# PMO 战报卡片图表数据源：bitable（默认，读多维表）| csv（读 ~/.jachin/client_volumes/PMO/output 下 CSV）
# PMO_BATTLE_REPORT_DATA_SOURCE=bitable
# 三张仪表盘卡片（需求战报+资源负荷+版本发布）开关在 YAML：pmo_dashboard_three_cards.enabled（无单独环境变量）
# 可选覆盖 YAML 中 pmo_dashboard_push.app_token（一般不必设）
# PMO_DASHBOARD_APP_TOKEN=

# ========== 设备 ==========
# DEVICE_ID=
# Layer 3 神经接驳时上报的自定义设备名，便于 L2 审批识别（如：客厅电脑、书房笔记本）
# JACHIN_DEVICE_NAME=
# L2 Sensory WebSocket 端口（默认 18881，仅 L2 daemon 使用）
# SENSORY_WS_PORT=18881

# ========== 语音 (Whisper / TTS / VAD) ==========
# 云端 TTS 总开关：未显式开启则为关闭（避免阻塞文本流、避免误连微软）。语音 API 需设为 true 才合成。
# JACHIN_TTS_ENABLED=true
# TTS 提供商：edge_tts（默认，免费，需能访问微软服务）| aliyun（需 DASHSCOPE_API_KEY 或 QWEN_API_KEY）
# Edge TTS 若出现 NoAudioReceived，多为网络/区域限制，可改用 aliyun 或配置代理
# TTS_PROVIDER=edge_tts
# Whisper 模型路径，如 E:\AIModels\whisper
WHISPER_MODEL_PATH=
# 桌面端 VAD 模型根目录（可选）：在此目录下的 vad/silero_vad.onnx 会被使用。
# 例如设为 E:\jachin-system\data 时，将使用 E:\jachin-system\data\vad\silero_vad.onnx
# 不设置时，程序会使用便携目录 _portable_data/vad 或系统数据目录
# JACHIN_VAD_DEBUG_PATH=E:\jachin-system\data
# 阿里云语音（可选）
ALIYUN_APP_KEY=
# 缓存目录，Whisper 会在 $XDG_CACHE_HOME/whisper 查找模型
# XDG_CACHE_HOME=

# ========== V2 L2 控制面 ==========
# L2 用此 Key 加密存储 api_keys_vault，未设置时每次启动生成临时 Key，重启后无法解密已有 Key，L3 将收不到 API Key
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
JACHIN_L2_MASTER_KEY=
# 须与 L1 Nexus 的 L1_L2_LOGIN_SHARED_SECRET 完全一致；用于请求 L1 的 l2-gateway/*（成员列表、slug→org 等）
# NEXUS_L2_LOGIN_SECRET=
# L1 Nexus 根 URL（默认 localhost:3000）
# NEXUS_BASE_URL=http://localhost:3000
# Admin 面板：已废弃 JACHIN_L2_ADMIN_TOKEN，改用 username/password + JWT 登录
# JWT_SECRET=  # JWT 密钥，无则每次启动自动生成（重启后旧 token 失效）
# JWT_EXPIRATION_HOURS=24
# 单机模式：L2 启动时自动将 DASHSCOPE_API_KEY/OPENAI_API_KEY 等同步到默认子账号，免去 Admin 手动添加
# JACHIN_SYNC_API_KEYS_FROM_ENV=1   # 默认开启，设为 0 可禁用

# ========== 项目 ==========
# JACHIN_PROJECT_ROOT=
# 技能数据目录，默认 ~/.jachin
# JACHIN_DATA_DIR=
# K8s 横向扩展：L2 状态存储路径，指向共享卷（NFS/EFS）
# JACHIN_L2_DB_PATH=/data/l2_control.db      # SQLite，多 Pod 需共享
# JACHIN_LANCEDB_PATH=/data/lancedb_data     # 记忆向量库

# ========== Sentinel ==========
SENTINEL_TEST_MODE=0

# ========== 技能 ==========
SKILLS_REPO_PATH=./skills_repo
# resource_mount 型 Persona/Memory 只读挂载点
RESOURCES_REPO_PATH=./resources_repo
BRAIN_BASE_URL=http://localhost:18888
SKILL_RUNTIME=docker
SKILL_AUTO_ENABLE=true
SKILL_MAX_CONCURRENT=10
SKILL_DEFAULT_TIMEOUT=300

# ========== 拓扑 (Super Node vs Distributed) ==========
NODE_MODE=standalone
IS_BRAIN_LOCAL=true

# ========== 集群 ==========
CLUSTER_MODE=single
# ENVIRONMENT=
DISCOVERY_METHOD=mdns
# CLUSTER_NODE_ID=
# CLUSTER_NODE_NAME=
CLUSTER_NODE_ROLE=head

# ========== 配置路径（L2 配置随代码就近，规范 075）==========
CLUSTER_CONFIG_PATH=core/config/cluster.yaml
SKILLS_CONFIG_PATH=core/config/skills_config.yaml

# ========== BI 后台 SPA 抓取（bi_daily_report full_spa）==========
# 与 config/skills/com.jachin.bi.daily_report/bi_daily_report.yaml 中 full_spa.base_url / cdp_url 对应
BI_DATA_URL=https://bi-admin-web.heronpro.xin/#/layout/person
BI_SPA_CDP_URL=http://127.0.0.1:9222
# BI_LARK_WEBHOOK_URL=
# 邮件战报：与 bi_daily_report.yaml distribution.email 三处同步
# BI_SMTP_TO=
# BI_SMTP_USER=
# BI_SMTP_PASSWORD=

# ========== BI 每日战报 · 定时（开关与时间以 YAML 为准；同事 v0.8.56「三处同步」+ 本地 BI 说明合并）==========
# APScheduler 以 YAML 为准；改开关/时间请同时核对下列位置，避免一处改漏：
#   1) 项目根 .env：BI_DAILY_REPORT_SCHEDULE=on|off（off/0/false 强制关定时；on/1/true 强制开，覆盖仓库默认关）
#   2) 项目 config/skills/com.jachin.bi.daily_report/bi_daily_report.yaml：schedule_enabled、schedule.enabled、schedule.hour、schedule.minute、schedule.mode
#   3) %USERPROFILE%\.jachin\config\skills\com.jachin.bi.daily_report\bi_daily_report.yaml（同上字段，本机覆盖优先）
# 另：可选 bi_scheduler.yaml 覆盖（见 bi_scheduler.yaml.example）
# L3 启动 http_server 时注册 BI 专属 APScheduler（不依赖 HR）
# 排查：~/.jachin/client_volumes/bi_data/logs/bi_scheduler_audit.log
# BI_DAILY_REPORT_SCHEDULE=off

# ========== Lark / BI助手 ==========
# BI 机器人应用凭证（Lark↔L3 终端连接、战报推送、多维表同步）
# BI_LARK_APP_ID=cli_xxx
# BI_LARK_APP_SECRET=xxx
# BI 机器人所在会话 chat_id（如 oc_xxx），用于推送战报及 Lark↔终端镜像
# BI_LARK_CHAT_ID=oc_xxx
# 05 付费用户次留表、07 付费用户周环比 table_id（与 bi_daily_report.yaml 保持一致）
# BI_LARK_TABLE_05=tblc8C8Qs3CjWxpG
# BI_LARK_TABLE_07=tblVqFqEvDeJ2N7f
# Step 4 仪表盘自动化：以 bi_daily_report.yaml 中 dashboard_automation.dashboards 为准（含第 4 个「仪表盘_游戏情况」分享链接）
# 可选：用环境变量覆盖单个 URL 时与 YAML 四者保持一致
# BI_LARK_DASHBOARD_1_URL=https://xxx.feishu.cn/base/xxx?view=blkXXX
# BI_LARK_DASHBOARD_2_URL=
# BI_LARK_DASHBOARD_3_URL=
# BI_LARK_DASHBOARD_4_URL=https://xxx.sg.larksuite.com/share/base/dashboard/xxx
# 通用 Lark 凭证（未配置时从 atom_lark_notifier config 或 BI_* 读取）
# LARK_APP_ID=
# LARK_APP_SECRET=
# 飞书中国版（open.feishu.cn），不设置则为 Lark 国际版；BI 助手通常需设为 1
# LARK_USE_FEISHU=1
# Lark 消息转发到 L3 的 WebSocket 地址（插件 lark_bot / run_bi_lark_long_connection 需在 .env 或 plugin/.env 配置）
# L3_WS_URL=ws://127.0.0.1:18981/sensory

# ========== L3 Memory Nexus · 技能矩阵 ==========
# 启动时是否把全量工具向量同步到 Skill_Matrix（默认 1；0=跳过，减轻启动负载；动态检索未索引时需手动同步或再开）
# JACHIN_SKILL_MATRIX_SYNC_ON_STARTUP=0
# 动态技能检索（JACHIN_DYNAMIC_TOOL_RETRIEVAL=1）：线程内 Memory Nexus 的硬超时秒数（默认 10，上限 120）
# JACHIN_DYNAMIC_TOOL_RETRIEVAL_ASYNC_TIMEOUT_SEC=10
# Native core:local_memory_search：to_thread+wait_for 秒数（默认 30）
# JACHIN_LOCAL_MEMORY_SEARCH_TIMEOUT_SEC=30
# Native core:local_memory_append：写入熔断秒数（默认 20）
# JACHIN_LOCAL_MEMORY_APPEND_TIMEOUT_SEC=20
# Memory Nexus 嵌入模型（FastEmbed）；默认多语言 MiniLM，可改为 fastembed 支持的任意模型名
# JACHIN_MEMORY_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# deep_search 参与余弦打分的最大候选条数（按时间倒序截取，默认 2500）
# JACHIN_NEXUS_DEEP_SEARCH_CANDIDATES=2500

# ========== L5 本地记忆「梦境合并 / 坍缩」（l3_local.json，默认启用）==========
# 主库路径默认 ~/.jachin/memory/l3_local.json；调度状态 ~/.jachin/memory/compact_schedule.json
# 关闭整个坍缩（不调用 LLM、不写回）：JACHIN_MEMORY_COMPACT_ENABLED=0
# 单次 LLM 超时秒数（默认 120）
# JACHIN_MEMORY_COMPACT_TIMEOUT_SEC=120
# 是否要求 API 侧 JSON 模式（默认 1；与 litellm response_format 相关）
# JACHIN_MEMORY_COMPACT_RESPONSE_JSON=1
# 用户每发一条会话消息就尝试检查是否需坍缩（仅该路径受「条目数 > 150」阈值；显式口令/桌面横幅整理为 force，无视阈值，空库不调 LLM）
# JACHIN_MEMORY_COMPACT_ON_SESSION=1
# 定时「是否整理」提示与 WS 倒计时（默认开启）；关闭：JACHIN_MEMORY_SCHEDULE_ENABLED=0
# 默认每 3 天、倒计时 10 秒（亦可在聊天里改，或改状态文件）
# JACHIN_MEMORY_SCHEDULE_INTERVAL_DAYS=3
# JACHIN_MEMORY_SCHEDULE_COUNTDOWN_SEC=10

# ========== 巡检中枢 · Kalaroko E2E / MCP / 定时任务（L3 /api/v1/monitor/* + kalaroko_scheduler）==========
# 桌面「巡检中枢」经 SSE 调多轮 E2E；须本机 Chrome 远程调试 +（可选）上方 DashScope Key 与 LLM_COMPLEX_MODEL。
# 持久化路径由代码约定：~/.jachin/data/kalaroko_e2e.jsonl、~/.jachin/data/kalaroko_scheduler_state.json（一般无需 env 覆盖）。
# 每日晨报（Lark + JSONL 滚动）：默认 UTC 0:15（≈北京 8:15），与整点巡检/BI 错峰；完全关闭：KALAROKO_DAILY_MORNING_REPORT=0
# KALAROKO_DAILY_MORNING_REPORT=1
#
# —— CDP / Playwright（MCP execute_playwright_perf_test；必填 CDP）——
# 先启动带 --remote-debugging-port 的 Chrome（如 scripts/launch_chrome_debug.ps1），MCP 仅 connect_over_cdp，不自动 launch。
KALAROKO_CDP_ENDPOINT=http://127.0.0.1:9222
# 每次巡检新建标签页，避免脏页（推荐调度/无人值守）：1/true/on
# KALAROKO_CDP_NEW_TAB=1
# CDP 复用用户 context 时，巡检结束后关闭本轮占用的标签（减轻 H5 泄漏；会关 Tab，勿与用户主大厅同签）：1/true/on
# KALAROKO_CDP_CLOSE_INSPECTION_TAB_AFTER_RUN=1
# headless 主要作用于非 CDP 的 launch 回退；CDP 连接时是否可见由已开 Chrome 决定。E2E 脚本未设时默认 false
# KALAROKO_HEADLESS=true
#
# —— GameQA · Kalaroko Tongits（L3 本地 MCP gameqa_mcp；YOLO 截图语义）——
# 训练产出见 data/gameqa_tongits_king_yolo/；权重路径请填本机绝对路径（可用正斜杠）。
# GAMEQA_YOLO_MODEL=D:/project/jachin-system-main/data/gameqa_tongits_king_yolo/runs/detect/tongits_king/train/weights/best.pt
# GAMEQA_YOLO_CONF=0.25
# GAMEQA_YOLO_DEVICE=cpu
# 可选：GAMEQA_YOLO_IMG_SIZE=640
# GameQA 截图 OCR（get_semantic_state 内与 YOLO 并行；默认开启）
# GAMEQA_OCR_ENABLED=1
# GAMEQA_OCR_MAX_CHARS=6000
# Playwright 自起 Chromium 默认不经系统代理：需与 Clash 等一致时设下列其一
# GAMEQA_PROXY_URL=http://127.0.0.1:8800
# 或：GAMEQA_PLAYWRIGHT_USE_PROXY=1（无其它 URL 时默认 http://127.0.0.1:8800）
# 关闭：GAMEQA_PLAYWRIGHT_USE_PROXY=0
# 依赖：pip install -r l3_client/local_mcps/gameqa_mcp/requirements.txt
#
# Playwright storage_state JSON（有头登录后导出，可选）
# KALAROKO_AUTH_STATE_PATH=
# 允许采集的主机白名单（逗号分隔）；不设时 E2E 脚本内建默认含 kalaroko.com、gweb、gwp.heronpro.xin 等
# KALAROKO_MONITOR_ALLOWED_HOSTS=kalaroko.com,www.kalaroko.com,gweb.kalaroko.com,gwp.heronpro.xin
# MCP manage_perf_history 非默认 jsonl 路径时设置（默认 ~/.jachin/data/kalaroko_e2e.jsonl）
# KALAROKO_PERF_HISTORY_PATH=
#
# —— 大厅点击流 / 布局微调（mcp_kalaroko_monitor；均有默认值，一般不必设）——
# KALAROKO_LOBBY_STATS_WAIT_MS=2000
# KALAROKO_BOTTOM_CHROME_RESERVE_PX=112
# KALAROKO_SUPPRESS_TABBAR_PE=1
# 调试：跳过游戏内顶栏退出 UI（仅排障）
# KALAROKO_GAME_EXIT_SKIP_UI=0
# 游戏「晚期就绪」墙钟竞速总预算（毫秒）：晚期 UI / 后置强业务 XHR 主停表；默认 60000（60s），范围 15000～120000
# 仅当显式需要旧版行为时设 KALAROKO_GAME_LATE_CANVAS_RACE=1（Loading 期也有 Canvas，易误早停，默认关）
# KALAROKO_GAME_LATE_READY_RACE_MS=60000
# KALAROKO_GAME_LATE_CANVAS_RACE=0
# 晚期竞速轮询片（毫秒）：asyncio.wait 超时片，让出事件循环；默认 120，范围 50～500
# KALAROKO_LATE_RACE_POLL_TICK_MS=120
# 点击流进桌后 URL 含 game-frame 的轮询上限（毫秒），默认 8000，范围 1500～30000
# KALAROKO_GAME_FRAME_POLL_MS=8000
# 引擎资源静默雷达（WebGL / 缓存重连）：.json/.png/.bundle/.wasm 等 URL 计数 ≥ 该值且连续静息 ≥ IDLE_SEC 才确认；停表时刻回溯到最后一次资源请求（不把确认等待摊进真实加载时长）
# KALAROKO_ASSET_SILENCE_MIN_COUNT=15
# KALAROKO_ASSET_SILENCE_IDLE_SEC=4.5
# 代码内另有硬编码：资源静默停表须距「加载零点」t_start 已超过 5s，防止大厅点击后瞬间假静默（不可配）
#
# —— 飞书推送与报告时区（与文件顶部「巡检中枢 · 飞书 Open API」一致，可在此集中填写）——
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_CHAT_ID=
# KALAROKO_REPORT_TZ=utc8
#
# —— 大模型（多轮末尾 Qwen 分析、每日 24h 晨报；与上方 JACHIN_ACTIVE_REGION + DashScope Key 配合）——
# LLM_COMPLEX_MODEL=qwen3-max

# ========== Healthchecks.io · 与 Kalaroko 巡检产出绑定（可选）==========
# 仅在「飞书巡检战报」经 Open API 完整发送成功后 GET 该 URL（无周期线程；Playwright 卡死未产出报告则不会 ping）。
# 在 https://healthchecks.io 创建 Check 后复制 ping URL；勿将真实 UUID 提交到 Git，写在 ~/.jachin/.env 或本机 .env。
# JACHIN_HEALTHCHECKS_PING_URL=https://hc-ping.com/<your-uuid>
# 兼容别名：HEALTHCHECKS_PING_URL=

# ========== 日志 ==========
# INFO 为默认；设为 DEBUG 可输出 L3 Key 拉取、L2 auth/poll、nodes/assign 等关键节点日志
LOG_LEVEL=INFO
# L3 桌面/终端排查「无文字」等：写入 ~/.jachin/l3_debug.log（完整时间戳+级别+模块名）；=1 时额外记录 WS 每条 chunk、LLM 流式 delta 预览（日志会很大，排障后请关掉）
# JACHIN_L3_DEBUG=1
# 启动时打印当前进程全部环境变量（已合并项目 .env）；=1/true 为脱敏；=raw/full 为明文（勿外传日志）
# JACHIN_L3_DEBUG_PRINT_ENV=1
LOG_FILE_PATH=logs/jachin.log
LOG_ROTATION=00:00
LOG_RETENTION=10 days
