# =============================================================================
# Jachin L3 / 便携包 — 东南亚（及国际站）部署用环境变量示例
# =============================================================================
# 使用方式：复制为 ~/.jachin/.env 或便携包根目录 .env
#   copy .env.sea.example .env
#
# 重要：
# - DASHSCOPE_API_KEY 须为阿里云「国际版 / Model Studio 国际站」控制台申请的 Key，
#   与国内（北京）控制台密钥通常不互通，请与控制台「API 地址」说明一致。
# - 必须设置 DASHSCOPE_API_BASE 指向国际兼容端点，否则 LiteLLM/嵌入会误连国内域名。
# =============================================================================

# ---------- 百炼 / 通义（国际站）----------
# 国际 OpenAI 兼容 Base（推荐默认，与 LiteLLM、DashScope 嵌入共用）
# 若控制台要求使用新加坡地域，可改为下行「可选新加坡地域」地址（二选一以控制台为准）。
DASHSCOPE_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 可选（新加坡地域，部分账号/文档使用此 host）：
# DASHSCOPE_API_BASE=https://dashscope.ap-southeast-1.aliyuncs.com/compatible-mode/v1

# 三选一即可，与主模板相同优先级：QWEN_AI_API_KEY > DASHSCOPE_API_KEY > QWEN_API_KEY
DASHSCOPE_API_KEY=
# QWEN_API_KEY=
# QWEN_AI_API_KEY=

LLM_PROVIDER=qwen-v2
LLM_MODEL=qwen3.5-plus
# LLM_CODER_MODEL=qwen3-coder-plus
# LLM_TIMEOUT=180

# QwenAdapterV2 / 部分 API 路径的地域枚举：新加坡（勿再用 cn-beijing）
QWEN_REGION=ap-singapore

# ---------- 可选：仍使用 OpenAI 官方或其它供应商 ----------
# OPENAI_API_KEY=

# ---------- L3 网络与网关（按实际拓扑修改）----------
SERVER_HOST=0.0.0.0
SERVER_PORT=18888
DEBUG=false

# L2 控制面地址（东南亚机器需能访问你的 L2 主机或内网穿透地址）
# BRAIN_BASE_URL=http://your-l2-host:18888

# ---------- Lark 国际版（东南亚团队常用 larksuite）----------
# https://open.larksuite.com
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_CHAT_ID=

# ---------- 云端市场 / 认证（若使用全球域名可保持默认；大陆专线可另配）----------
CLOUD_MARKET_URL=https://market.jachin.io
CLOUD_AUTH_URL=https://auth.jachin.io

# ---------- 代理（仅当目标机访问 DashScope / 微软服务受限时）----------
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- L2 密钥保险库（多机部署 L2 时勿留空）----------
# JACHIN_L2_MASTER_KEY=
